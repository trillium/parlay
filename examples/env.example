# Parlay environment — copy to your shell profile and edit.
#
# Nothing here is mandatory: every value has a working default. Set a variable
# when you want to override the default, or when you are running a second,
# sandboxed instance and must keep it off the real one.
#
# So every line below is commented out and shows the default it would replace.
# Uncomment only what you mean to change — several of these move where the
# server reads as well as where it writes, and each says so where it applies.

# ── Server (packages/go-server — the only server) ─────────────────────────────
#
# Every variable here is also a flag on the same binary; the flag wins if you set
# both. Start it with `cd packages/go-server && go run ./cmd/parlay-server -h`.
# There is no second server implementation left in this repo — the TypeScript one
# these variables used to describe was deleted in the Bun-to-Go cutover, along
# with PARLAY_PORT, PARLAY_DATA_DIR and PARLAY_HUB_URL.

# Address to listen on (flag: -addr). Default 127.0.0.1:4242 — LOOPBACK ONLY.
#
# WARNING: the chat API has no authentication of any kind, on any route. Anyone
# who can reach the port can read the history and post as any agent. Loopback is
# the only thing standing between a default install and your LAN; change the host
# half only behind something that authenticates, never to a public tunnel or a
# forwarded port.
# export PARLAY_SERVER_ADDR="127.0.0.1:4242"

# Directory the server persists into (flag: -state-dir): messages.jsonl,
# agents.json, settings.json, draft.json, uploads/, channels.json. Default
# ~/.parlay.
#
# COLLISION: this is the same variable the CLI uses for its own state, below. At
# the default the server writes its whole persistence set into the directory
# holding config.json, sweep-keep and agents/. That is tidy for one instance and
# a collision for two — give a second server its own -state-dir.
#
# MOVING IT MOVES THE READ SIDE TOO. Do not repoint a running instance: it comes
# back with an empty history and an empty registry, so the panel has nothing to
# render and no tabs until every agent re-registers. Stop the server, move the
# files, start it again.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# Directory holding the built packages/client/dist bundle (flag: -assets-dir).
# Default: <repo>/packages/client/dist when it exists, else ./dist. Point it at
# an empty directory for a headless instance so a real build is never served by
# accident.
# export PARLAY_ASSETS_DIR="$HOME/code/parlay/packages/client/dist"

# TTS cache and substitutions (flag: -pai-dir). The only path OUTSIDE
# -state-dir the server writes: <pai-dir>/MEMORY/STATE/tts-cache/,
# <pai-dir>/MEMORY/OBSERVABILITY/tts-pronunciation-reports.jsonl and
# <pai-dir>/tts-substitutions.json. Default ~/.claude/PAI. Set it for a
# sandboxed instance — otherwise it writes into your real PAI tree even when
# everything else is scratch.
# export PAI_DIR="$HOME/.claude/PAI"

# External phrase-matching engine for POST /api/chat/eval. Default
# http://127.0.0.1:4343; the route answers 502 until something is listening
# there, and the panel works fine without it. The engine ships inside the parlay
# binary — `parlay eval serve`.
# export PARLAY_EVAL_ENGINE_URL="http://127.0.0.1:4343"

# Extra browser origins the origin guard accepts on guarded routes
# (comma-separated exact origins; "*" disables the check). Same-origin,
# loopback, .local and private-LAN origins are already allowed, and a request
# with no Origin header — every CLI/curl/hook caller — always is. See
# packages/go-server/internal/guard (route set in GuardedPaths).
# Only GET /api/chat/events and POST /api/chat/eval (and their preflights) also
# accept the wider tailnet/LAN set (Tailscale 100.64.0.0/10, *.ts.net, bare
# single-label hostnames like http://macbook:8787, IPv6 ULA/link-local); the
# stream echoes Access-Control-Allow-Origin for those and for origins listed
# here verbatim (never a wildcard), so the herdr web page's spoken "bravely" submits with no
# configuration. List only an origin outside those ranges (e.g. a tunnel).
# export PARLAY_ALLOWED_ORIGINS="https://tunnel.example.com"

# Rewrites http://localhost:<port> / http://127.0.0.1:<port> links in served
# message text to http://<host>:<port> — so links you read off-home (phone,
# another machine, Tailscale) resolve instead of dying. Unset means no rewrite.
# "auto" resolves the host once per process from `tailscale status --json`'s
# short node name, failing open to no-rewrite if Tailscale is unavailable. Any
# other value is used literally (hostname, FQDN, or IP). Presentation-only: the
# stored message log is never mutated.
# export PARLAY_PUBLIC_HOST="macbook"

# Dual-write observability events onto the Gas City event bus. Both default OFF.
# Each needs the pinned gc binary on PATH (or PARLAY_GC) and, for -bus-consume, a
# running gc supervisor; without one the flag degrades to backoff-retry rather
# than failing. Turning one ON with no usable gc is a hard startup error on
# purpose, so nobody is left with a silently dead dual-write.
# export PARLAY_BUS_EMIT=1
# export PARLAY_BUS_CONSUME=1

# Path to the gc binary; empty resolves from PATH (bus flags only).
# export PARLAY_GC=""

# Address to listen on (flag: -addr). Default 127.0.0.1:4242 — loopback only.
# It has no authentication, but its /api/chat routes are guarded by
# internal/guard (Origin + JSON content-type on mutating paths). Change the
# host half only behind something that authenticates.
# export PARLAY_SERVER_ADDR="127.0.0.1:4242"

# Directory go-server persists into (flag: -state-dir) — messages, the agent
# registry, drafts, settings, uploads. Default ~/.parlay.
#
# COLLISION: this is the same variable the CLI uses for its own state, below.
# Leave it at ~/.parlay for both and go-server writes its whole persistence set
# into the directory holding config.json, sweep-keep and agents/. Point
# -state-dir somewhere separate when you run go-server.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# parlay-owned Gas City city root; empty means <state-dir>/gascity/city (bus
# flags only).
# export PARLAY_GC_CITY=""

# ── CLI (tools/cli) ──────────────────────────────────────────────────────────

# Which server the CLI talks to. Highest precedence — beats ~/.parlay/config.json
# and the coded default http://localhost:4242. Leave it unset if you want
# config.json to decide (see parlay-state/README.md).
# export PARLAY_SERVER="http://localhost:4242"

# Root for CLI state: config.json, sweep-keep, the poll cursor. Default ~/.parlay.
#
# SHARED WITH packages/go-server, which reads this same variable as its own
# -state-dir default and writes messages, the agent registry, drafts, settings
# and uploads under it. If you run go-server, give it a separate -state-dir
# rather than letting it persist into your curated CLI state.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# Root for per-agent stores (identity.md, scratchpad.md, context.json, status).
# Default ~/.parlay/agents.
#
# CAVEAT: honored by identity/scratchpad/say/status/doctor and by sweep's
# candidate list, but NOT by launch, teardown, variant, or guard — those
# resolve ~/.parlay/agents from $HOME directly (parlayAgentsDir in
# internal/commands/guard.go).
#
# `sweep` splits the two ways round: its candidate list and each candidate's
# status come from this variable, its keep-list from $PARLAY_STATE_HOME/sweep-keep
# — but the teardown it then PERFORMS resolves ~/.parlay/agents from $HOME. So a
# redirected sweep can classify an agent out of the redirected store and then go
# looking for it under your real home, and `sweep --apply` is the verb that
# deletes stores and removes worktrees. It fails toward held, but do not lean on
# that.
#
# Redirect $HOME as well if you need a fully isolated instance;
# bootstrap-sandbox.sh does.
# export PARLAY_AGENT_HOME="$HOME/.parlay/agents"

# ── Set per-agent, by the spawner, not in your profile ───────────────────────
#
# PARLAY_AGENT_ID     tells every agent-scoped verb (say, reply, scratchpad,
#                     identity, status, doctor) WHICH agent is calling. Without
#                     it those verbs exit 2 unless you pass --agent <id>.
# PARLAY_STATUS_FILE  overrides the status file path for one agent.

# ── Internal / advanced (not for a normal shell profile) ─────────────────────
#
# The spawner, relay, monitor, herdr integration, and CI-account tooling read
# many more PARLAY_* variables (launcher selection, watchdog timeouts, relay
# socket/runtime paths, debug logging, split-testing knobs, and similar). They
# are set by the tool that needs them, not by a user — each is documented at
# its point of use (`tools/cli/internal/spawn/`, `tools/relay/`, `tools/cli/internal/`,
# `docs/agent-notes/`), not duplicated here. If you are hand-setting one of
# these outside its owning tool's own instructions, you are probably debugging
# something rather than configuring a normal instance.
