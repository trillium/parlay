# Parlay environment — copy to your shell profile and edit.
#
# Nothing here is mandatory: every value has a working default. Set a variable
# when you want to override the default, or when you are running a second,
# sandboxed instance and must keep it off the real one.
#
# So every line below is commented out and shows the default it would replace.
# Uncomment only what you mean to change — several of these move where the
# server reads as well as where it writes, and each says so where it applies.

# ── Server (packages/server — the TypeScript/Bun one) ────────────────────────
#
# packages/go-server reads NONE of the three variables in this section. It has
# its own block further down.

# TCP port the server listens on. Default 4242.
#
# WARNING: there is no bind-address setting, and there is no authentication.
# packages/server calls serve({ port }) with no hostname, so Bun binds 0.0.0.0 —
# this port is reachable from every interface, and anyone who reaches it can read
# your chat history and post as any agent. Firewall it, or front it with
# something that authenticates, before running on an untrusted network.
# export PARLAY_PORT=4242

# Redirects EVERY file the server persists into this one directory: message
# history, draft, settings, uploads, the agent registry, the session→channel
# maps. Unset, those files scatter to ~/exchange and $PAI_DIR/MEMORY/STATE.
# Worth setting on a new instance — one directory you can back up, instead of
# six paths you have to remember.
#
# ORPHANS EXISTING STATE: it moves the READ side too, so do not switch it on for
# a server that has been running without it. The panel comes up empty (your
# history is still in ~/exchange/chat-history.jsonl), every tab is gone until
# each agent re-registers (your registry is still at
# $PAI_DIR/MEMORY/STATE/parlay-agents.json), and the server then builds a second,
# divergent registry in here. Stop the server and move the existing files into
# the new directory first — same filenames, flat.
# export PARLAY_DATA_DIR="$HOME/.parlay/data"

# Root the hook/tool tailers watch for agent activity. Default ~/.claude/PAI.
#
# Read UNCONDITIONALLY — PARLAY_DATA_DIR does not cover it. The hook tailer, the
# tool tailer, and the boot-time session-channel backfill all read
# $PAI_DIR/MEMORY/OBSERVABILITY, and the TTS code WRITES
# $PAI_DIR/MEMORY/{OBSERVABILITY/tts-pronunciation-reports.jsonl,STATE/tts-cache/}
# regardless of PARLAY_DATA_DIR. Set this too if you want a fully isolated
# instance; leave it unset and the server reads and writes inside your real
# ~/.claude/PAI. bootstrap-sandbox.sh sets it.
#
# A real path or nothing at all — never an empty one. It is resolved with ??,
# not ||, so PAI_DIR="" is a value rather than "unset", and every $PAI_DIR/...
# path becomes relative to the server's working directory: the tailers read, and
# src/tts.ts writes, a MEMORY/ tree wherever you happened to start the server.
# An unset variable inside the value you export does exactly this.
# export PAI_DIR="$HOME/.claude/PAI"

# External phrase-matching engine for POST /api/chat/eval. The route answers 502
# until something is listening there; the panel works fine without it.
# export PARLAY_EVAL_ENGINE_URL="http://127.0.0.1:4343"

# Go SSE hub the hook/tool tailers push into (src/hub-ingress.ts): POST
# /api/chat/events for tool events, POST /api/chat/message for hook firings.
# NOT derived from PARLAY_PORT — that is this server's own listen port. Set
# this explicitly whenever the Go hub is not on the default port. Unreachable
# ⇒ posts are dropped with a rate-limited warn and tailing continues.
# export PARLAY_HUB_URL="http://127.0.0.1:4242"

# Extra browser origins the guard accepts on guarded routes (comma-separated
# exact origins; "*" disables the origin check entirely). Same-origin,
# loopback, .local and private-LAN origins are already allowed, and a request
# with no Origin header — every CLI/curl/hook caller — always is. See
# src/guard/ (route set in src/guard/paths.ts).
# export PARLAY_ALLOWED_ORIGINS="https://tunnel.example.com"

# ── Server (packages/go-server — the Go rewrite) ─────────────────────────────
#
# Two variables, both also settable as flags, and neither shared with the block
# above. Skip this section entirely if you run packages/server.
#
# PARLAY_ALLOWED_ORIGINS is shared with packages/server above — go-server reads
# the same variable, same semantics (internal/guard/guard.go).

# Address to listen on (flag: -addr). Default 127.0.0.1:4242 — loopback only,
# unlike packages/server. It has no authentication either, and no equivalent of
# packages/server/src/guard.ts, so its write routes have no Origin or
# content-type check at all. Change the host half only behind something that
# authenticates.
# export PARLAY_SERVER_ADDR="127.0.0.1:4242"

# Directory go-server persists into (flag: -state-dir) — messages, the agent
# registry, drafts, settings, uploads. Default ~/.parlay.
#
# COLLISION: this is the same variable the CLI uses for its own state, below.
# Leave it at ~/.parlay for both and go-server writes its whole persistence set
# into the directory holding config.json, sweep-keep and agents/. Point
# -state-dir somewhere separate when you run go-server.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# ── CLI (tools/cli) ──────────────────────────────────────────────────────────

# Which server the CLI talks to. Highest precedence — beats ~/.parlay/config.json
# and the coded default http://localhost:4242. Leave it unset if you want
# config.json to decide (see parlay-state/README.md).
# export PARLAY_SERVER="http://localhost:4242"

# Root for CLI state: config.json, sweep-keep, the poll cursor. Default ~/.parlay.
#
# SHARED WITH packages/go-server, which reads this same variable as its own
# -state-dir default and writes messages, the agent registry, drafts, settings
# and uploads under it. If you run go-server, give it a separate -state-dir
# rather than letting it persist into your curated CLI state.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# Root for per-agent stores (identity.md, scratchpad.md, context.json, status).
# Default ~/.parlay/agents.
#
# CAVEAT: honored by identity/scratchpad/say/status, but NOT by launch, teardown,
# variant, or guard — those resolve ~/.parlay/agents from $HOME directly.
#
# `sweep` is split across both: its candidate list comes from the $HOME-based
# ~/.parlay/agents (ignoring this variable), its keep-list from
# $PARLAY_STATE_HOME/sweep-keep, and each candidate's status from this variable.
# So a redirected sweep enumerates your REAL agents against a redirected
# keep-list — and `sweep --apply` is the verb that deletes stores and removes
# worktrees.
#
# Redirect $HOME as well if you need a fully isolated instance;
# bootstrap-sandbox.sh does.
# export PARLAY_AGENT_HOME="$HOME/.parlay/agents"

# ── Set per-agent, by the spawner, not in your profile ───────────────────────
#
# PARLAY_AGENT_ID     tells every agent-scoped verb (say, reply, scratchpad,
#                     identity, status, doctor) WHICH agent is calling. Without
#                     it those verbs exit 2 unless you pass --agent <id>.
# PARLAY_STATUS_FILE  overrides the status file path for one agent.

# ── Internal / advanced (not for a normal shell profile) ─────────────────────
#
# The spawner, relay, monitor, herdr integration, and CI-account tooling read
# many more PARLAY_* variables (launcher selection, watchdog timeouts, relay
# socket/runtime paths, debug logging, split-testing knobs, and similar). They
# are set by the tool that needs them, not by a user — each is documented at
# its point of use (`bin/parlay-spawn`, `tools/relay/`, `tools/cli/internal/`,
# `docs/agent-notes/`), not duplicated here. If you are hand-setting one of
# these outside its owning tool's own instructions, you are probably debugging
# something rather than configuring a normal instance.
