# Parlay environment — copy to your shell profile and edit.
#
# Nothing here is mandatory: every value has a working default. Set a variable
# when you want to override the default, or when you are running a second,
# sandboxed instance and must keep it off the real one.

# ── Server (packages/server, or packages/go-server) ──────────────────────────

# TCP port the server listens on. Default 4242.
export PARLAY_PORT=4242

# Redirects EVERY file the server persists into this one directory: message
# history, draft, settings, uploads, the agent registry, the session→channel
# maps. Unset, those files scatter to ~/exchange and $PAI_DIR/MEMORY/STATE.
# Set it. It is the difference between one directory you can back up and six
# paths you have to remember.
export PARLAY_DATA_DIR="$HOME/.parlay/data"

# Root the hook/tool tailers watch for agent activity. Only consulted when
# PARLAY_DATA_DIR is unset. Default ~/.claude/PAI.
# export PAI_DIR="$HOME/.claude/PAI"

# External phrase-matching engine for POST /api/chat/eval. The route answers 502
# until something is listening there; the panel works fine without it.
# export PARLAY_EVAL_ENGINE_URL="http://127.0.0.1:4343"

# ── CLI (tools/cli) ──────────────────────────────────────────────────────────

# Which server the CLI talks to. Highest precedence — beats ~/.parlay/config.json
# and the coded default http://localhost:4242. Leave it unset if you want
# config.json to decide (see parlay-state/README.md).
# export PARLAY_SERVER="http://localhost:4242"

# Root for CLI state: config.json, sweep-keep, the poll cursor. Default ~/.parlay.
# export PARLAY_STATE_HOME="$HOME/.parlay"

# Root for per-agent stores (identity.md, scratchpad.md, context.json, status).
# Default ~/.parlay/agents.
#
# CAVEAT: honored by identity/scratchpad/say/status, but NOT by launch, teardown,
# variant, or guard — those resolve ~/.parlay/agents from $HOME directly. Redirect
# $HOME as well if you need a fully isolated instance; bootstrap-sandbox.sh does.
# export PARLAY_AGENT_HOME="$HOME/.parlay/agents"

# ── Set per-agent, by the spawner, not in your profile ───────────────────────
#
# PARLAY_AGENT_ID     tells every agent-scoped verb (say, reply, scratchpad,
#                     identity, status, doctor) WHICH agent is calling. Without
#                     it those verbs exit 2 unless you pass --agent <id>.
# PARLAY_STATUS_FILE  overrides the status file path for one agent.
