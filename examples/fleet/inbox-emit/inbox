#!/bin/sh
# inbox — brain-federation wrapper pinned to the inbox store, PLUS a create-emit
# hook (inbox routing). On `inbox create`, after bd succeeds, append the new bead
# id to a byte-offset-tailable events stream so a poll/tail daemon can dispatch
# a handler with sub-~1s latency. EVERYTHING except the `create` subcommand is
# byte-identical to the original wrapper (plain `exec bd "$@"`), so the emit hook
# can only ever affect `inbox create` — never list/show/close/label/etc.
#
# Canonical source: examples/fleet/inbox-emit/inbox in the parlay repo, installed to
# ~/.local/bin/inbox by examples/fleet/inbox-emit/install.sh (which backs up the original).
# Edit it here, not the installed copy.
#
# FLEXIBLE STORE PINS: every variable below is a *default*, not a force — a
# pre-set environment value always wins. To run against a temporary/test DB:
#
#   BEADS_DIR=/tmp/itest/.beads INBOX_EVENTS_FILE=/tmp/itest/events.jsonl inbox list
#
# When BEADS_DIR is overridden, the shared-server pins are NOT applied (the
# temp store runs embedded), unless the caller explicitly sets them. Explicit
# empty (`BEADS_DOLT_SHARED_SERVER=`) also disables — empty is respected, never
# re-defaulted. BRAIN_KNOWLEDGE_ROOT and INBOX_EVENTS_FILE derive from
# BEADS_DIR when unset, so temp stores keep their exfil + events next to the DB.
#
# Server-mode store on the shared Dolt sql-server (127.0.0.1:3307); the explicit
# shared-server pins mirror the review/brain wrappers so bd never falls back to
# embedded mode or mis-discovers a sibling database — but only for the
# canonical store (see above).

# --- store identity (defaults; pre-set env wins) ------------------------------
if [ -z "${BEADS_DIR+x}" ]; then
  BEADS_DIR="$HOME/data/inbox/.beads"
  _INBOX_CANONICAL=1
else
  _INBOX_CANONICAL=0
fi
export BEADS_DIR
if [ -z "${BD_NAME+x}" ]; then BD_NAME="inbox"; fi
export BD_NAME
if [ -z "${BRAIN_KNOWLEDGE_ROOT+x}" ]; then BRAIN_KNOWLEDGE_ROOT="${BEADS_DIR%/*}"; fi
export BRAIN_KNOWLEDGE_ROOT
if [ -z "${BRAIN_EXFIL_FLAT+x}" ]; then BRAIN_EXFIL_FLAT=1; fi
export BRAIN_EXFIL_FLAT

# --- storage mode -------------------------------------------------------------
# Canonical store: pin the launchd-managed shared server unless the caller
# already chose (including explicit empty = embedded). Temp/overridden store:
# stay embedded unless the caller explicitly opts into server mode.
if [ "${_INBOX_CANONICAL:-0}" = 1 ]; then
  if [ -z "${BEADS_DOLT_SERVER_MODE+x}" ]; then BEADS_DOLT_SERVER_MODE=1; fi
  if [ -z "${BEADS_DOLT_SERVER_HOST+x}" ]; then BEADS_DOLT_SERVER_HOST=127.0.0.1; fi
  if [ -z "${BEADS_DOLT_SERVER_PORT+x}" ]; then BEADS_DOLT_SERVER_PORT=3307; fi
  if [ -z "${BEADS_DOLT_SHARED_SERVER+x}" ]; then BEADS_DOLT_SHARED_SERVER=1; fi
fi
if [ -n "${BEADS_DOLT_SERVER_MODE+x}" ]; then export BEADS_DOLT_SERVER_MODE; fi
if [ -n "${BEADS_DOLT_SERVER_HOST+x}" ]; then export BEADS_DOLT_SERVER_HOST; fi
if [ -n "${BEADS_DOLT_SERVER_PORT+x}" ]; then export BEADS_DOLT_SERVER_PORT; fi
if [ -n "${BEADS_DOLT_SHARED_SERVER+x}" ]; then export BEADS_DOLT_SHARED_SERVER; fi
unset _INBOX_CANONICAL

if [ -z "${INBOX_EVENTS_FILE+x}" ]; then
  INBOX_EVENTS_FILE="${BRAIN_KNOWLEDGE_ROOT}/events.jsonl"
fi

if [ "${1:-}" = "create" ]; then
  # Capture stdout to scrape the new id and echo it back unchanged; stderr flows
  # through normally. Command substitution strips trailing newlines, so re-add one.
  out=$(bd "$@")
  code=$?
  printf '%s\n' "$out"
  if [ "$code" -eq 0 ]; then
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # Temp/test stores may point INBOX_EVENTS_FILE at a directory tree that
    # does not exist yet — ensure it before the first append (no-op live).
    _events_dir="${INBOX_EVENTS_FILE%/*}"
    if [ -n "$_events_dir" ] && [ "$_events_dir" != "$INBOX_EVENTS_FILE" ]; then
      mkdir -p "$_events_dir" 2>/dev/null || true
    fi
    unset _events_dir
    # The creating agent is the only process that knows which channel should
    # receive a close notification. Stamp the subscription on the bead before
    # emitting it; absent PARLAY_AGENT_ID, creation remains successful but has
    # no close-notification subscriber.
    agent="${PARLAY_AGENT_ID:-}"
    # Match bd's own "Created issue: inbox-XXX" line so ids inside a title/desc
    # never trigger a false emit. Emit one line per created id (batch-safe).
    printf '%s' "$out" | grep -oE 'Created issue: inbox-[a-z0-9]+' | sed 's/^Created issue: //' | while IFS= read -r id; do
      [ -z "$id" ] && continue
      if [ -n "$agent" ]; then
        bd label add "$id" "notify:$agent" >/dev/null 2>&1 || true
        printf '{"id":"%s","created_at":"%s","source":"inbox-create","agent":"%s"}\n' "$id" "$ts" "$agent" >> "$INBOX_EVENTS_FILE" 2>/dev/null || true
      else
        printf '{"id":"%s","created_at":"%s","source":"inbox-create"}\n' "$id" "$ts" >> "$INBOX_EVENTS_FILE" 2>/dev/null || true
      fi
    done
  fi
  exit "$code"
fi

exec bd "$@"
