<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- TEMPLATE: replace every @MAIL_HOME@ with the durable mail root
     ($HOME/data/agent-mail — see agent-mail.env.template) before loading,
     e.g. sed "s|@MAIL_HOME@|$HOME/data/agent-mail|g". Never load a copy
     pointing at /tmp: the pilot's /tmp pool and mesh were lost on reboot.
     Do NOT load/unload this unit yourself: launchd cutover is
     firstmate-primary-only (see agent-mail-runbook.md). -->
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@MAIL_HOME@/fork/.venv/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HTTP_HOST</key>
		<string>127.0.0.1</string>
		<key>HTTP_PORT</key>
		<string>18765</string>
		<key>STORAGE_ROOT</key>
		<string>@MAIL_HOME@/pilot-data/mailbox</string>
		<key>DATABASE_URL</key>
		<string>sqlite+aiosqlite:///@MAIL_HOME@/pilot-data/storage.sqlite3</string>
		<key>NOTIFICATIONS_ENABLED</key>
		<string>true</string>
		<key>NOTIFICATIONS_SIGNALS_DIR</key>
		<string>@MAIL_HOME@/pilot-data/signals</string>
		<key>LOG_RICH_ENABLED</key>
		<string>false</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.mailpilot.backend</string>
	<key>ProgramArguments</key>
	<array>
		<string>@MAIL_HOME@/fork/.venv/bin/python</string>
		<string>-m</string>
		<string>mcp_agent_mail.cli</string>
		<string>serve-http</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@MAIL_HOME@/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>@MAIL_HOME@/launchd.out.log</string>
	<key>WorkingDirectory</key>
	<string>@MAIL_HOME@/fork</string>
</dict>
</plist>
