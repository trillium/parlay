# agent-mail durable environment template.
# Copy to a host-local file (NOT in the repo) and source it, or inject the
# same keys via launchd EnvironmentVariables (see com.mailpilot.backend.plist
# and agent-mail-runbook.md). The one rule: nothing under /tmp — the pilot's
# /tmp pool and mesh were lost on reboot, so the durable home is ~/data.
#
#   cp examples/fleet/agent-mail.env.template "$HOME/data/agent-mail/env"
#   set -a; . "$HOME/data/agent-mail/env"; set +a

# Durable mail root. Every committed asset derives its paths from this.
MAIL_HOME="$HOME/data/agent-mail"

# Managed mcp_agent_mail clone + venv (a variable, never a /tmp literal).
MAIL_FORK="$MAIL_HOME/fork"
MAIL_VENV="$MAIL_FORK/.venv"

# Backend HTTP surface (matches the plist + keepalive proxy defaults).
HTTP_HOST="127.0.0.1"
HTTP_PORT="18765"

# Backend storage (matches the plist): git archive, sqlite, signal files.
STORAGE_ROOT="$MAIL_HOME/pilot-data/mailbox"
DATABASE_URL="sqlite+aiosqlite:///$MAIL_HOME/pilot-data/storage.sqlite3"
NOTIFICATIONS_ENABLED="true"
NOTIFICATIONS_SIGNALS_DIR="$MAIL_HOME/pilot-data/signals"
LOG_RICH_ENABLED="false"

# Keep-alive fix proxy (agent-mail-keepalive-proxy.py): Jungle points here.
PROXY_HOST="127.0.0.1"
PROXY_PORT="18766"
PROXY_TARGET="http://127.0.0.1:18765"

# Signal -> Parlay wake bridge (agent-mail-notify.py). The seat -> pane map
# lives outside the repo (pane ids are ephemeral); state is durable so a
# reboot never double-pokes a pane for the same mail.
NOTIFY_MAP="$MAIL_HOME/notify-map.json"
NOTIFY_STATE="$MAIL_HOME/notify-state.json"
