node_modules
dist
.env
packages/client/pulse-agent.js
packages/client/plugins/

# Build/runtime junk that kept leaking into git status (tree-hygiene, decision-u6v).
*.log
*.bak-*
__pycache__/
tools/relay/relay
interceptor-screenshot-*.png
.claude-file-plan.json
.worktrees/
tools/cli/bin/

# The remaining compiled Go binaries `go build ./...` drops in each module root.
# ~28 MB of these were committed once and still weigh on every clone, so every
# module's output is listed here so none can be re-added.
# (tools/relay/relay is already ignored above; the entries here keep every
# module's binary path visible in this one file. packages/eval-engine merged
# into tools/cli — task-0ke9 — and tools/parlay-bin was folded into
# tools/cli/internal/spawn — task-42qot — so neither has a binary entry.)
#
# packages/spawn-profiles/validate was missing until 2026-08-26. Nothing caught
# it because that module was also missing from CI's GO_MODULES, so the go job's
# "No build artifact may be left untracked" step had never run against it — the
# same omission hid both. If a seventh module appears, its binary belongs here
# and the module belongs in GO_MODULES; the workflow now fails if the latter is
# forgotten.
tools/cli/cli
packages/spawn-profiles/validate

# Go server build artifact (9.9MB) — CI hygiene gate caps tracked blobs at 2 MiB
packages/go-server/parlay-server

# city/ is authored Gas City source, never a live city. Running gc against it
# in place writes a .gc/ state dir — that is a bug (see city/README.md), but
# committing that live state would be worse, so it is ignored as a backstop.
city/.gc/

# .fm-hooks/ is firstmate behavioral-hook telemetry, historically written into
# $CWD. Fixed upstream in fm-hooks 2e34642 ("Keep observer state out of the
# working directory"): state now resolves from homedir to
# ~/.local/state/fm-hooks, with per-repo namespacing by resolved real path and
# 5 MB x 3 rotation. Verified 2026-10-05 — a post-fix process leaves no
# .fm-hooks directory in its repo at all, so task-vejyd is resolved.
#
# KEEP THIS ENTRY until every long-lived harness process predating that commit
# has restarted. A pi session that loaded the extension before the fix keeps the
# old code in memory and keeps writing to $CWD/.fm-hooks/queue/events.jsonl for
# its whole lifetime. Removing this line while such a session is live re-dirties
# `git status --porcelain` and blocks every gnhf run (ensureCleanWorkingTree).
# Safe to drop once no pre-fix process remains.
.fm-hooks/

# .pi/ is the pi harness's own scratch directory — task logs under .pi/tasks/,
# generated images under .pi/generated-images/. None of it is product source,
# and the rule is that no harness scratch file is ever committed. It has
# already been broken once: a harness auto-commit captured four .pi/tasks/
# task-log files onto an onboarding branch (2026-10-07), which is why this is
# an ignore entry rather than a convention.
.pi/

# packages/server/ is a two-file leftover of the completed Bun→Go cutover
# (1e05e859, #277), restored locally and never re-tracked. server.js is a Bun
# bundle artifact — it opens with `// @bun` and carries __defProp/__export
# runtime shims, so it is compiled output, not source. src/parlay-ui.js is the
# retired `GET /parlay-ui.js` panel route; go-server/internal/static serves
# packages/client/dist instead. Nothing tracked imports either file. Committing
# them would resurrect a deleted component and contradict the cutover, but
# deleting them is not recoverable and they are not worth the risk, so they are
# ignored as a backstop — the same call as city/.gc/ above.
packages/server/
