#!/usr/bin/env bash
# Tracked post-commit hook: COMMIT = DELIVERY (captain directive 2026-07-18).
# After any commit on the MAIN checkout that changes panel build inputs, rebuild
# and deliver the bundle. build.ts fails loud on compile errors (stale bundle
# left untouched) and broadcasts /api/chat/reload to live panels on success.
# Complements: pre-commit PA_VERSION auto-bump + the com.parlay.bundle-rebuild
# launchd WatchPaths agent (covers uncommitted live-dev edits to version.ts).
# This hook closes the paths pre-commit misses: merges, PA_BUMP=none, --no-verify.
set -uo pipefail  # NOT -e: a delivery failure must never read as a commit
                  # failure. The one deliberate non-zero exit is an unresolvable
                  # primary checkout below on a clone that OPTED IN, where guessing
                  # could deliver from the wrong tree; a build/delivery failure
                  # still exits 0.

# Opt-in, per CLONE — this config lands in the shared .git/config every linked
# worktree of the clone reads, so setting it once from any checkout enables them
# all (enabling is not delivering: the primary-checkout guard below still decides
# where delivery happens). `bun install` installs these hooks for everyone, so the
# rebuild (which runs a build and POSTs to a local port) must not fire on a
# machine that never asked for it. A git config rather than an env var: a hook
# fires from IDEs, GUIs and cron-like contexts that never sourced a shell
# profile, and `git config core.hooksPath` is already how these are activated.
# Read here, ACTED ON below — only once this commit is known to be one that would
# otherwise have delivered, so an unrelated commit never says anything at all.
AUTOBUILD="$(git config --bool --get parlay.autobuild 2>/dev/null || true)"

# Deploy target = this repo's PRIMARY checkout, never a linked worktree. Derived
# from git (`--git-common-dir` is shared by every worktree and lives inside the
# primary checkout) so no machine-specific path is baked in; PARLAY_MAIN_CHECKOUT
# overrides when you deploy from somewhere else. resolve_dir refuses an empty or
# unreadable path instead of resolving it: bash 3.2 treats `cd ""` as success, so
# tolerating it would silently yield the hook's cwd — the top of whatever tree is
# committing — and let a linked worktree deploy.
resolve_dir() { [[ -n "${1:-}" ]] || return 1; (cd "$1" 2>/dev/null && pwd -P); }
if [[ -n "${PARLAY_MAIN_CHECKOUT:-}" ]]; then
  MAIN_CHECKOUT="$(resolve_dir "$PARLAY_MAIN_CHECKOUT")" || MAIN_CHECKOUT=""
else
  COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  COMMON_DIR="$(resolve_dir "$COMMON_DIR")" || COMMON_DIR=""
  MAIN_CHECKOUT="$(resolve_dir "${COMMON_DIR%/.git}")" || MAIN_CHECKOUT=""
fi
if [[ -z "$MAIN_CHECKOUT" ]]; then
  # A clone that never opted in was not going to deliver anyway, so an
  # unresolvable checkout is not its problem — say nothing. Opted in, this is the
  # one deliberate non-zero exit: refuse rather than guess a delivery target.
  [[ "$AUTOBUILD" == "true" ]] || exit 0
  echo "[post-commit] refusing to deliver: cannot resolve the primary checkout — PARLAY_MAIN_CHECKOUT is unset or unreadable and 'git rev-parse --path-format=absolute --git-common-dir' returned nothing (git older than 2.31?)" >&2
  exit 1
fi

# Naming the log file is not writing to it: the directory is created only on a
# path that is about to write, so a clone that never opted in leaves no trace on
# disk — no directory, no file, no line — for any commit anywhere in the tree.
LOG="${PARLAY_HOOK_LOG:-$HOME/Library/Logs/parlay/bundle-rebuild.out.log}"
TOP="$(resolve_dir "$(git rev-parse --show-toplevel)")" || TOP=""

# Worktree commits (treehouse leases, feature isolation) must never deploy.
if [[ "$TOP" != "$MAIN_CHECKOUT" ]]; then
  if [[ "$AUTOBUILD" == "true" ]]; then
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
    echo "[post-commit] $(date +%FT%T) skip: $TOP is not the main checkout" >> "$LOG"
  fi
  exit 0
fi

# What this commit changed (first-parent diff also covers merge commits).
if git rev-parse -q --verify HEAD^ >/dev/null 2>&1; then
  CHANGED="$(git diff --name-only HEAD^ HEAD)"
else
  CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD)"
fi

echo "$CHANGED" | grep -qE '^packages/client/(src|src-plugins)/|^packages/client/build\.ts' || exit 0

# This commit would have delivered, so the opt-in decides — and announces itself,
# on stdout, exactly here: loud enough that a clone which never enabled delivery
# knows why nothing was built, silent on every commit the feature never touched.
if [[ "$AUTOBUILD" != "true" ]]; then
  echo "[post-commit] delivery skipped — parlay.autobuild is not set for this clone."
  echo "[post-commit] enable with: git config --bool parlay.autobuild true"
  exit 0
fi

# Hooks fire from IDEs, GUIs and cron-like contexts with a minimal PATH, so keep
# the absolute fallback for the common install location.
BUN="$(command -v bun || echo "$HOME/.bun/bin/bun")"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
echo "[post-commit] $(date +%FT%T) delivering $(git log -1 --format='%h %s' | head -c 80)" >> "$LOG"
if ( cd "$MAIN_CHECKOUT/packages/client" && "$BUN" build.ts ) >> "$LOG" 2>&1; then
  echo "[post-commit] delivered" >> "$LOG"
else
  echo "[post-commit] DELIVERY FAILED — bundle unchanged; fix and run 'bun build.ts' in packages/client" >> "$LOG"
fi
