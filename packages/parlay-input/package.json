{
  "name": "parlay-input",
  "version": "0.1.0",
  "description": "Unscoped alias for @parlay/input — install @parlay/input directly for docs and the real implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build.ts && tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "@parlay/input": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trillium/parlay.git",
    "directory": "packages/parlay-input"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
