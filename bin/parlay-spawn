#!/usr/bin/env bash
# parlay-spawn — launch a NEW background Claude Code agent "from Parlay".
#
# Spins up a fresh, TOP-LEVEL `claude` session inside a detached herdr terminal
# that auto-enrolls a Parlay monitor on startup, so the agent shows up as a
# live, reachable tab in the Pulse/Parlay chat panel (http://localhost:31337)
# immediately.
#
# Precedent: ~/.local/bin/lavish (auto-claim pattern). This differs: instead of
# claiming an existing session, it registers a brand-new agent, posts a hello so
# the tab goes live, then launches the agent with a startup prompt that arms the
# monitor and works the task.
#
# The CLAUDECODE nesting problem: Claude Code refuses to launch a nested `claude`
# subprocess when CLAUDECODE / CLAUDE_CODE_* are set. herdr terminals INHERIT the
# parent env, so the launch wrapper explicitly `unset`s those vars — verified to
# produce a clean top-level session (2026-07-13).
#
# Usage:
#   parlay-spawn <agent-id> <display-name> <hex-color> <initial-prompt> [--cwd PATH] [--focus] [--model MODEL]
#
# Example:
#   parlay-spawn code-reviewer "Code Reviewer" "#c084fc" \
#     "Review the diff in ~/code/foo and report findings." --cwd ~/code/foo
#
# Env:
#   PARLAY_SERVER   Parlay/Pulse base URL (default http://localhost:31337)

set -euo pipefail

PARLAY="${PARLAY_SERVER:-http://localhost:31337}"

# Absolute path to THIS script, so the batch loop can re-exec us in single mode
# regardless of the cwd or relative path used to invoke us (mirror fm-spawn.sh's
# $FM_ROOT/bin/fm-spawn.sh self-reference).
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Deterministic, readable hex color from an id — a bash port of colorFromId()
# in packages/cli/src/identity-ephemeral.ts (FNV-1a 32-bit, each channel squeezed
# into 40–220 so no tab accent is too dark or too washed out). Same id ⇒ same
# color, so a batch-spawned agent paints the same accent every launch, matching
# the ephemeral-identity convention. Bash arithmetic is 64-bit here, so masking
# with 0xffffffff after each step reproduces the JS `>>> 0` wraparound.
color_from_id() {
  local id="$1"
  local h=2166136261 i=0 c
  local len=${#id}
  while [ "$i" -lt "$len" ]; do
    c=$(printf '%d' "'${id:$i:1}")
    h=$(( (h ^ c) & 0xffffffff ))
    h=$(( (h * 16777619) & 0xffffffff ))
    i=$((i + 1))
  done
  local r=$(( 40 + (h & 0xff) % 181 ))
  local g=$(( 40 + ((h >> 8) & 0xff) % 181 ))
  local b=$(( 40 + ((h >> 16) & 0xff) % 181 ))
  printf '#%02x%02x%02x' "$r" "$g" "$b"
}

usage() {
  cat >&2 <<EOF
Usage: parlay-spawn <agent-id> <display-name> <hex-color> <initial-prompt> [--cwd PATH] [--focus]
       parlay-spawn --ephemeral <initial-prompt> [--cwd PATH] [--model MODEL] [--focus]
       parlay-spawn <id>=<repo> [<id>=<repo> ...] --prompt TEXT [--model M] [--color HEX] [--focus]

  agent-id        kebab-slug, stable across restarts (e.g. code-reviewer)
  display-name    tab header text (e.g. "Code Reviewer")
  hex-color       tab accent color (e.g. "#c084fc")
  initial-prompt  the task the spawned agent should work

  --ephemeral     mint a random hash identity (id="eph-XXXXXXXX", derived name,
                  deterministic color) instead of id/name/color positionals.
                  Must be the FIRST arg — cannot combine with an explicit agent-id.
  --cwd PATH      working directory for the spawned claude (default: \$HOME)
  --focus         focus the new terminal (default: launched --no-focus)
  --model MODEL   pin the claude model (e.g. sonnet, opus, haiku, or a full
                  model id); default: session default with sonnet fallback

Batch dispatch: when the first arg is an <id>=<repo> pair, every positional is
  treated as one and spawned by re-execing this script in single mode. The <repo>
  becomes that agent's --cwd; the display name is the id and the tab color is
  derived from it (or shared via --color). A shared --prompt is required and given
  to every agent; --model/--focus/--color are shared too. A failed pair is reported
  and skipped, the rest still launch, and the batch exits non-zero if any failed.
    parlay-spawn fix-a=~/code/foo add-b=~/code/bar --prompt "Do the thing" --model sonnet

Env: PARLAY_SERVER (default http://localhost:31337)
EOF
  exit 2
}

# ── Ephemeral hash-identity path ────────────────────────────────────────────
# `parlay-spawn --ephemeral "<prompt>" [--cwd PATH] [--model MODEL] [--focus]`
# mints a random hash identity (id="eph-XXXXXXXX", derived name, deterministic
# color) instead of taking id/name/color positionals. Mutually exclusive with an
# explicit agent-id: --ephemeral must be the FIRST arg. The mint step seeds the
# store (context.json + identity.md with `ephemeral: true`), so the ephemeral
# path skips the trailing named-agent --register (mint already did it).
EPHEMERAL=0
if [ "${1:-}" = "--ephemeral" ]; then
  EPHEMERAL=1
  shift
  [ $# -lt 1 ] && { echo "parlay-spawn: --ephemeral requires a prompt" >&2; usage; }
  PROMPT="$1"; shift

  # Parse the ephemeral tail flags first — --cwd/--model must be known before the
  # mint so they land in the seeded frontmatter.
  CWD="$HOME"
  FOCUS_FLAG="--no-focus"
  MODEL=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd)       CWD="$2"; shift 2 ;;
      --focus)     FOCUS_FLAG="--focus"; shift ;;
      --model)     MODEL="$2"; shift 2 ;;
      --ephemeral) echo "parlay-spawn: --ephemeral given twice" >&2; usage ;;
      *) echo "parlay-spawn: unknown arg: $1" >&2; usage ;;
    esac
  done

  # Mint id/name/color and seed the store. Prints a TAB-separated "<id>\t<name>\t<color>"
  # line (name contains a space, so tabs keep the three fields unambiguous).
  MINT=$(PARLAY_SERVER="$PARLAY" parlay identity --mint-ephemeral --cwd "$CWD" ${MODEL:+--model "$MODEL"}) \
    || { echo "parlay-spawn: --ephemeral mint failed (is the parlay CLI on PATH?)" >&2; exit 1; }
  AGENT_ID=$(printf '%s' "$MINT" | cut -f1)
  NAME=$(printf '%s' "$MINT" | cut -f2)
  COLOR=$(printf '%s' "$MINT" | cut -f3)
  if [ -z "$AGENT_ID" ] || [ -z "$NAME" ] || [ -z "$COLOR" ]; then
    echo "parlay-spawn: --ephemeral mint returned an unusable identity: '$MINT'" >&2
    exit 1
  fi
  echo "parlay-spawn: minted ephemeral identity $AGENT_ID ($NAME, $COLOR)" >&2
fi

# ── Batch dispatch (thin loop) ──────────────────────────────────────────────
# When the FIRST arg is an `id=repo` pair — it contains an '=' and the id-part
# (before the '=') has no '/' — treat every positional as one pair and spawn each
# by re-execing this script in single mode. This is the parlay port of firstmate's
# fm-spawn.sh batch (`fm-spawn.sh fix-a=projects/foo add-b=projects/bar`): the loop
# lives here in bash so callers never hand-write it. A single-task invocation
# never carries an '=' in arg one (agent ids are bare kebab slugs), and an id that
# contains '/' is not a pair, so both fall straight through to the single path.
#
# Differences from firstmate: there is no per-id brief file, so a shared --prompt
# is REQUIRED and handed to every agent; the <repo> becomes each agent's --cwd; the
# display name is the id and the color is derived from it (colorFromId), or set for
# the whole batch with --color. --model/--focus are forwarded to every pair.
# A failed pair is reported and skipped; the rest still launch; exit is non-zero if
# any pair failed (rc=1 spawn failure, rc=2 bad arg / missing --prompt).
if [ "$EPHEMERAL" -eq 0 ] && [ $# -gt 0 ]; then
  _first="$1"
  case "$_first" in
    -* ) : ;;                              # a flag, not a pair → not batch
    *=* )
      _idpart="${_first%%=*}"
      case "$_idpart" in
        */* ) : ;;                          # slash in id-part → not a pair
        * )
          # Batch mode. Separate pairs (positionals) from shared flags.
          PAIRS=()
          BATCH_PROMPT=""
          BATCH_MODEL=""
          BATCH_COLOR=""
          BATCH_FOCUS="--no-focus"
          while [ $# -gt 0 ]; do
            case "$1" in
              --prompt) BATCH_PROMPT="$2"; shift 2 ;;
              --model)  BATCH_MODEL="$2"; shift 2 ;;
              --color)  BATCH_COLOR="$2"; shift 2 ;;
              --focus)  BATCH_FOCUS="--focus"; shift ;;
              --cwd)    echo "parlay-spawn: --cwd is not valid in batch mode (each id=repo pair supplies its own cwd via <repo>)" >&2; exit 2 ;;
              --ephemeral) echo "parlay-spawn: --ephemeral cannot combine with batch id=repo pairs" >&2; exit 2 ;;
              -*)       echo "parlay-spawn: unknown batch flag: $1" >&2; exit 2 ;;
              *)        PAIRS+=("$1"); shift ;;
            esac
          done

          if [ -z "$BATCH_PROMPT" ]; then
            echo "parlay-spawn: batch dispatch requires a shared --prompt (the brief handed to every spawned agent)" >&2
            exit 2
          fi

          rc=0
          for pair in ${PAIRS[@]+"${PAIRS[@]}"}; do
            case "$pair" in
              *=*) : ;;
              *) echo "parlay-spawn: batch dispatch expects every argument as id=repo; got '$pair'" >&2; rc=2; continue ;;
            esac
            _bid="${pair%%=*}"
            _brepo="${pair#*=}"
            # Expand a leading ~ so `id=~/code/foo` resolves (mid-word tildes are
            # not expanded by the shell).
            # shellcheck disable=SC2088  # literal ~ case patterns, expansion handled below
            case "$_brepo" in
              "~")   _brepo="$HOME" ;;
              "~/"*) _brepo="$HOME/${_brepo#\~/}" ;;
            esac
            _bcolor="${BATCH_COLOR:-$(color_from_id "$_bid")}"
            _shared=(--cwd "$_brepo")
            [ -n "$BATCH_MODEL" ] && _shared+=(--model "$BATCH_MODEL")
            [ "$BATCH_FOCUS" = "--focus" ] && _shared+=(--focus)
            if "$SELF" "$_bid" "$_bid" "$_bcolor" "$BATCH_PROMPT" ${_shared[@]+"${_shared[@]}"}; then
              :
            else
              echo "batch: FAILED to spawn $_bid ($_brepo)" >&2
              rc=1
            fi
          done
          exit "$rc"
          ;;
      esac
      ;;
  esac
fi

if [ "$EPHEMERAL" -eq 0 ]; then
[ $# -lt 4 ] && usage

AGENT_ID="$1"; NAME="$2"; COLOR="$3"; PROMPT="$4"; shift 4

CWD="$HOME"
FOCUS_FLAG="--no-focus"
MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd)   CWD="$2"; shift 2 ;;
    --focus) FOCUS_FLAG="--focus"; shift ;;
    --model) MODEL="$2"; shift 2 ;;
    --ephemeral) echo "parlay-spawn: --ephemeral must be the first argument (cannot combine with an explicit agent-id)" >&2; usage ;;
    *) echo "parlay-spawn: unknown arg: $1" >&2; usage ;;
  esac
done
fi

# Validate agent id shape (kebab-slug).
if ! printf '%s' "$AGENT_ID" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "parlay-spawn: agent-id must be a kebab-slug (got: '$AGENT_ID')" >&2
  exit 2
fi

json_escape() { printf '%s' "$1" | jq -Rs .; }

# Refuse a duplicate: if a herdr agent with this id is already live, creating a
# second one leaves two identically-labeled "edgar" tabs (one a ghost) and is
# confusing. Reclaim the name first (kill the old session + close its tab) or use
# a different id. This is the up-front guard against same-name panes.
if command -v herdr >/dev/null 2>&1; then
  EXISTING_AGENT=$(herdr agent get "$AGENT_ID" 2>/dev/null | jq -r '.result.agent.name // empty' 2>/dev/null || true)
  if [ -n "$EXISTING_AGENT" ]; then
    echo "parlay-spawn: a herdr agent named '$AGENT_ID' already exists — refusing to create a duplicate." >&2
    echo "  Reclaim the name first: 'herdr agent list' to find it, kill its process, then 'herdr tab close <its tab>'." >&2
    echo "  Or spawn under a different agent-id." >&2
    exit 1
  fi
fi

echo "parlay-spawn: registering agent '$AGENT_ID' with Parlay at $PARLAY ..." >&2

# 1. Register the agent so the tab exists.
curl -s -X POST "$PARLAY/api/chat/register-agent" \
  -H "Content-Type: application/json" \
  -d "{\"id\":$(json_escape "$AGENT_ID"),\"name\":$(json_escape "$NAME"),\"color\":$(json_escape "$COLOR")}" \
  >/dev/null || { echo "parlay-spawn: register-agent failed — is Pulse running on $PARLAY?" >&2; exit 1; }

# 2. Post a hello reply so the tab goes live immediately.
curl -s -X POST "$PARLAY/api/chat/reply" \
  -H "Content-Type: application/json" \
  -d "{\"text\":$(json_escape "Spawning… arming monitor and starting on the task."),\"agent\":$(json_escape "$AGENT_ID"),\"name\":$(json_escape "$NAME"),\"color\":$(json_escape "$COLOR")}" \
  >/dev/null || true

# 2b. Write context.json for the agent (JSON file as primary for agent lookup).
AGENT_DIR="$HOME/.parlay/agents/$AGENT_ID"
mkdir -p "$AGENT_DIR"
jq -n --arg id "$AGENT_ID" --arg name "$NAME" --arg color "$COLOR" \
  '{id: $id, name: $name, color: $color}' > "$AGENT_DIR/context.json" || true
# Write a session-start sentinel (epoch seconds). The say-guard reads this to
# distinguish handoffs created in a prior session ("inherited") from ones this
# agent created itself. Overwrite on every spawn so the timestamp is always fresh.
date +%s > "$AGENT_DIR/session-start" || true

# 3. Compose the startup prompt: enrollment instructions + the task.
#    The fresh claude processes this as its first turn, so it arms the Monitor
#    (making the tab "listening") and posts a ready reply before/while working.
STARTUP_PROMPT=$(cat <<EOF
You are a background agent enrolled in the Pulse/Parlay chat panel at $PARLAY.
Your agent identity: id="$AGENT_ID", name="$NAME", color="$COLOR".

FIRST, before anything else, enroll so the captain can reach you — ONE call does the
whole thing (register + announce + arm the poll loop), safe to re-run on every restart:
1. Arm a persistent Monitor running 'parlay listen':
   Monitor({ command: "PARLAY_SERVER=$PARLAY parlay listen --agent $AGENT_ID --name \"$NAME\" --color \"$COLOR\"", persistent: true })
   This registers you in the agent registry, posts a "listening" announce to your own
   channel so your tab shows ready, then execs the same poll loop as 'parlay monitor' —
   no separate 'reply' or registration step needed. Your identity is already set
   (PARLAY_AGENT_ID=$AGENT_ID). (See the pulse-agent skill at ~/.claude/.agents/skills/pulse-agent/SKILL.md for the poll/contract details.)

2. Load your durable memory (it survives restarts): run 'identity' to read who you are and what you have learned about yourself, and 'scratchpad' to read what you were doing. If your identity shows a "📎 Handoff: handoff-XXX" pointer, run 'handoff show handoff-XXX' for the full state from your previous context. If your context was reset, this chain — identity → handoff → scratchpad — is how you recover; do it before you start.

Your surfaces are dead simple and already keyed to you (PARLAY_AGENT_ID) — no paths, no /tmp, no JSON. All three are thin wrappers over the one parlay tool. Use them religiously:
- reply '<message>'     — your ONLY reply channel to the captain.
- scratchpad '<note>'   — jot anything down; read it back with bare 'scratchpad'. NEVER write throwaway files in /tmp; use this instead.
- identity '<fact>'     — record something you learn about yourself (a trait, a failure mode, a lesson); read it with bare 'identity'.

Watch your context budget: when you approach ~80% used, checkpoint to the captain via reply (what is done, next, committed), record the lesson with 'identity', jot open state to 'scratchpad', and suggest a fresh session — never churn silently to 100%, which wedges and kills the session mid-task.

CLEAN SHUTDOWN / RESTART (work done, or context bloated/near the limit): write your handoff by running the 'handoff' skill (it creates a handoff bead), then IMMEDIATELY run 'identity --submit' — with NOTHING in between (no courtesy 'say', no other command). --submit needs no id: it resolves the handoff you just created from the store, so the create and the submit are effectively one atomic act. Interposing anything between the create and the submit is the one way to strand your shutdown — a dying context can be killed in that gap, leaving a live handoff bead but no restart. That IS the whole shutdown: --submit pins the handoff to your identity AND resets your context — it restarts you with a fresh context that recovers itself via identity → handoff → scratchpad. You do NOT run sudoku, context-reset, or any skill yourself; submitting the handoff is the shutdown. If you ever find yourself already past a 'handoff' create with the submit not yet run, run a bare 'identity --submit' now — it recovers that stranded handoff. NEVER --submit before any handoff bead exists — without one the reset you wakes with amnesia.

THEN work on this task and reply with 'reply "<your message>"' — once to acknowledge, again when done:

$PROMPT
EOF
)

# 4. Pre-trust the workdir so the spawned claude never stalls on the folder
#    trust dialog (captain's standing policy 2026-07-13: always trust).
CLAUDE_JSON="$HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ] && command -v jq >/dev/null; then
  _tmp=$(mktemp)
  if jq --arg p "$CWD" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$CLAUDE_JSON" > "$_tmp"; then
    mv "$_tmp" "$CLAUDE_JSON"
  else
    rm -f "$_tmp"; echo "parlay-spawn: warn: could not pre-trust $CWD (jq failed)" >&2
  fi
fi

# 5. Launch a fresh, TOP-LEVEL claude in a detached herdr terminal.
#    The bash wrapper UNSETS the nesting-marker env vars so Claude Code does not
#    treat this as a nested subprocess (empty-string via --env is NOT enough —
#    the guard checks presence, so we must `unset`).
echo "parlay-spawn: launching detached claude via herdr (cwd=$CWD, $FOCUS_FLAG) ..." >&2

# shellcheck disable=SC2016
# Runs in YOLO mode (skip-permissions + sonnet fallback) — same as the `yolo`
# command — so a remotely-driven agent never stalls on a permission prompt the
# absent user can't answer. `yolo` is a zsh function, unavailable in this bash
# login shell, so we replicate its exact behaviour here.
LAUNCH_SCRIPT='unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH AI_AGENT CLAUDE_EFFORT; exec claude --dangerously-skip-permissions --fallback-model sonnet ${PARLAY_SPAWN_MODEL:+--model "$PARLAY_SPAWN_MODEL"} "$PARLAY_SPAWN_PROMPT"'

# Give the agent its OWN tab (captain's rule 2026-07-13: agents never split the
# captain's current tab, and they launch unfocused/background). The tab's root
# shell pane is a harmless side effect — no pane-close verb exists in herdr 0.7.3.
TAB_FLAG=""
ROOT_PANE=""
TAB_JSON=$(herdr tab create --no-focus --label "$AGENT_ID" ${HERDR_WORKSPACE_ID:+--workspace "$HERDR_WORKSPACE_ID"} 2>/dev/null) || true
TAB_ID=$(printf '%s' "$TAB_JSON" | jq -r '.result.tab.tab_id // empty')
ROOT_PANE=$(printf '%s' "$TAB_JSON" | jq -r '.result.root_pane.pane_id // empty')
[ -n "$TAB_ID" ] && TAB_FLAG="--tab $TAB_ID"

# Roll back on failure: if agent start fails (e.g. name taken), close the tab we
# just created so it does not linger as a ghost "$AGENT_ID" tab. Without this,
# set -e aborts here and orphans the labeled tab — the exact two-same-name-tabs bug.
if ! herdr agent start "$AGENT_ID" --cwd "$CWD" $FOCUS_FLAG $TAB_FLAG \
  --env "PARLAY_SPAWN_PROMPT=$STARTUP_PROMPT" \
  --env "PARLAY_SPAWN_MODEL=$MODEL" \
  --env "PARLAY_SERVER=$PARLAY" \
  --env "PARLAY_AGENT_ID=$AGENT_ID" \
  -- bash -lc "$LAUNCH_SCRIPT"; then
  echo "parlay-spawn: herdr agent start failed — rolling back the tab to avoid a ghost '$AGENT_ID' tab." >&2
  [ -n "$TAB_ID" ] && herdr tab close "$TAB_ID" >/dev/null 2>&1 || true
  exit 1
fi

# Drop the tab's now-redundant root shell pane so the agent has the tab to
# itself. Only after the agent pane exists — closing a tab's only pane closes
# the tab (and a workspace's last tab closes the workspace).
[ -n "$ROOT_PANE" ] && herdr pane close "$ROOT_PANE" >/dev/null 2>&1 || true

# Seed the identity's LAUNCH SPEC (frontmatter) so the agent can reconstitute itself
# on context reset — the identity fully describes how to relaunch it. Best-effort.
# Ephemeral agents were already seeded by the mint step (with `ephemeral: true`);
# re-registering here without --ephemeral would strip that marker, so skip it.
if [ "$EPHEMERAL" -eq 0 ]; then
  identity --register --agent "$AGENT_ID" --name "$NAME" --color "$COLOR" --cwd "$CWD" ${MODEL:+--model "$MODEL"} >/dev/null 2>&1 || true
fi

echo "parlay-spawn: done. Agent '$AGENT_ID' registered; terminal launched." >&2
echo "parlay-spawn: watch it come live with: parlay subscribers | jq '.poll'" >&2
