#!/usr/bin/env bash
# parlay-spawn — launch a NEW background Claude Code agent "from Parlay".
#
# Spins up a fresh, TOP-LEVEL `claude` session inside a detached herdr terminal
# that auto-enrolls a Parlay monitor on startup, so the agent shows up as a
# live, reachable tab in the Pulse/Parlay chat panel (http://localhost:31337)
# immediately.
#
# Precedent: ~/.local/bin/lavish (auto-claim pattern). This differs: instead of
# claiming an existing session, it registers a brand-new agent, posts a hello so
# the tab goes live, then launches the agent with a startup prompt that arms the
# monitor and works the task.
#
# The CLAUDECODE nesting problem: Claude Code refuses to launch a nested `claude`
# subprocess when CLAUDECODE / CLAUDE_CODE_* are set. herdr terminals INHERIT the
# parent env, so the launch wrapper explicitly `unset`s those vars — verified to
# produce a clean top-level session (2026-07-13).
#
# Usage:
#   parlay-spawn <agent-id> <display-name> <hex-color> <initial-prompt> [--cwd PATH] [--focus] --model MODEL
#
# --model (or a model-bearing --profile) is REQUIRED — task-qyu8q: a model
# must be chosen deliberately on every spawn, never inherited from the
# launching session's default and never silently defaulted to sonnet.
#
# Example:
#   parlay-spawn code-reviewer "Code Reviewer" "#c084fc" \
#     "Review the diff in ~/code/foo and report findings." --cwd ~/code/foo
#
# Env:
#   PARLAY_SERVER                     Parlay/Pulse base URL (default http://localhost:31337)
#   PARLAY_SPAWN_DEFAULT_ACCOUNT      ccjuggler account name to use when --account is not given
#                                     (e.g. acc2). Resolved via the same keychain/file lookup as
#                                     --account. Set to "" to disable (use the ambient session token).
#   PARLAY_SPAWN_NO_WATCHDOG          1 disables the post-launch liveness watchdog (see step 6 below)
#   PARLAY_SPAWN_LIVENESS_TIMEOUT_MS  watchdog's "did the first turn fire" window (default 60000)

set -euo pipefail

PARLAY="${PARLAY_SERVER:-http://localhost:31337}"
# Default account — precedence: env var > ~/.parlay/config.toml spawnAccount > empty.
# Set persistently with: parlay spawn-account set <name>
_config_toml="${PARLAY_STATE_HOME:-$HOME/.parlay}/config.toml"
_config_account=""
if [ -z "${PARLAY_SPAWN_DEFAULT_ACCOUNT:-}" ] && [ -f "$_config_toml" ] && command -v python3 >/dev/null 2>&1; then
  _config_account=$(python3 - "$_config_toml" <<'PYEOF' 2>/dev/null || true
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    print(tomllib.load(f).get("spawnAccount", ""), end="")
PYEOF
)
fi
ACCOUNT="${PARLAY_SPAWN_DEFAULT_ACCOUNT:-$_config_account}"
unset _config_toml _config_account

# Launcher — herdr (default), subprocess (detached-subprocess escape hatch
# for herdr's SIGKILL failure mode in headless/no-WindowServer environments),
# or gc (opt-in Gas City session runtime — spawn-lift unit 5, task-4cfpv.9;
# the launch runs through `parlay gc-spawn`, which owns pinned-gc resolution,
# the city scaffold, template synthesis, and `gc session new`).
# Precedence: PARLAY_SPAWN_LAUNCHER env var > ~/.parlay/config.toml [spawn] launcher > herdr.
# The value "gascity" is the pre-rename spelling of SUBPROCESS (not of gc: it
# predates the real Gas City launcher) and stays accepted as a deprecated
# alias for one release — it normalizes to "subprocess" with a notice on
# stderr.
_config_toml="${PARLAY_STATE_HOME:-$HOME/.parlay}/config.toml"
_config_launcher=""
if [ -z "${PARLAY_SPAWN_LAUNCHER:-}" ] && [ -f "$_config_toml" ] && command -v python3 >/dev/null 2>&1; then
  _config_launcher=$(python3 - "$_config_toml" <<'PYEOF' 2>/dev/null || true
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    print(tomllib.load(f).get("spawn", {}).get("launcher", ""), end="")
PYEOF
)
fi
_resolved_launcher="${PARLAY_SPAWN_LAUNCHER:-${_config_launcher:-herdr}}"
case "$_resolved_launcher" in
  gascity)
    echo "parlay-spawn: WARNING — launcher 'gascity' is deprecated (renamed 'subprocess'); it still works until the next release." >&2
    LAUNCHER="subprocess"
    ;;
  *) LAUNCHER="$_resolved_launcher" ;;
esac
unset _config_toml _config_launcher _resolved_launcher
# --subprocess (parsed per-mode below) overrides all of the above — highest
# precedence. --gascity is its accepted, deprecated pre-rename spelling.

# beads-required mode — when on, every spawn MUST name an open beads work item
# (--bead <id>), and that bead's lifecycle then governs the agent's: `parlay
# identity --submit` closes it, and a closed bead stops `parlay launch` from
# ever respawning the agent. Off by default.
# Precedence: PARLAY_SPAWN_BEADS_REQUIRED env var > ~/.parlay/config.toml
# [spawn] beads_required > off. Same tomllib heredoc as [spawn] launcher above
# (a missing python3 silently falls through to off, as it does there).
_config_toml="${PARLAY_STATE_HOME:-$HOME/.parlay}/config.toml"
_config_beads=""
if [ -z "${PARLAY_SPAWN_BEADS_REQUIRED:-}" ] && [ -f "$_config_toml" ] && command -v python3 >/dev/null 2>&1; then
  _config_beads=$(python3 - "$_config_toml" <<'PYEOF' 2>/dev/null || true
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    v = tomllib.load(f).get("spawn", {}).get("beads_required", False)
# Normalize both spellings the key can legitimately carry — a TOML boolean
# (beads_required = true) and a quoted string ("true"/"1"/"yes"/"on") — to the
# single token "1" the shell below tests, so no caller has to know which.
print("1" if (v is True or str(v).strip().lower() in ("1", "true", "yes", "on")) else "", end="")
PYEOF
)
fi
_beads_required_raw="${PARLAY_SPAWN_BEADS_REQUIRED:-$_config_beads}"
case "$(printf '%s' "$_beads_required_raw" | tr '[:upper:]' '[:lower:]')" in
  1|true|yes|on) BEADS_REQUIRED=1 ;;
  *)             BEADS_REQUIRED=0 ;;
esac
unset _config_toml _config_beads _beads_required_raw
# --force overrides beads_required at call time
FORCE=0
BEAD_ID=""
# task-qyu8q: tracks whether the model-required gate already ran (it is
# called once pre-mint on the ephemeral path and once, idempotently, in the
# shared section — see require_model below) and whether --kind was passed
# explicitly (so a --profile's kind never silently overrides it).
_MODEL_GATE_DONE=""
KIND_FROM_FLAG=0

# Absolute path to THIS script, so the batch loop can re-exec us in single mode
# regardless of the cwd or relative path used to invoke us (mirror fm-spawn.sh's
# $FM_ROOT/bin/fm-spawn.sh self-reference).
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Physical dir of THIS script, following symlinks — parlay-spawn is normally
# invoked via the ~/.local/bin/parlay-spawn symlink, so $SELF's dir is the
# symlink's dir (~/.local/bin), NOT the repo's bin/ where our sibling scripts
# live. Resolve the link chain so BIN_DIR always points at the real bin/ and we
# can source herdr-contract next to us regardless of how we were invoked.
_pspawn_src="${BASH_SOURCE[0]}"
while [ -h "$_pspawn_src" ]; do
  _pspawn_dir="$(cd -P "$(dirname "$_pspawn_src")" && pwd)"
  _pspawn_src="$(readlink "$_pspawn_src")"
  [ "${_pspawn_src#/}" = "$_pspawn_src" ] && _pspawn_src="$_pspawn_dir/$_pspawn_src"
done
BIN_DIR="$(cd -P "$(dirname "$_pspawn_src")" && pwd)"
REPO_DIR="$(cd -P "$BIN_DIR/.." && pwd)"
unset _pspawn_src _pspawn_dir
# shellcheck source=parlay-pii-lib.sh
. "$BIN_DIR/parlay-pii-lib.sh"

# Resolve the beads-required error template: user override > repo copy.
_beads_err_user="${PARLAY_STATE_HOME:-$HOME/.parlay}/templates/beads-required-error.txt"
_beads_err_repo="$REPO_DIR/share/parlay/beads-required-error.txt"
if [ -f "$_beads_err_user" ]; then
  BEADS_REQUIRED_ERROR_TMPL="$_beads_err_user"
elif [ -f "$_beads_err_repo" ]; then
  BEADS_REQUIRED_ERROR_TMPL="$_beads_err_repo"
else
  BEADS_REQUIRED_ERROR_TMPL=""
fi
unset _beads_err_user _beads_err_repo

# herdr contract gate (robots-4v2e): the single source of truth for the herdr
# CLI shape parlay-spawn depends on. Sourced here; asserted at startup (below,
# after arg parsing) BEFORE we register anything, so a drifted herdr fails fast
# with a precise message instead of orphaning a half-created tab mid-launch.
if [ -f "$BIN_DIR/herdr-contract" ]; then
  # shellcheck source=/dev/null
  source "$BIN_DIR/herdr-contract"
fi

# herdr-rpc: socket-based herdr access — bypasses the binary in contexts where
# it cannot run (SIGKILL'd by macOS when there is no WindowServer session, e.g.
# subprocesses spawned by Claude Code or CI). Sourced unconditionally; the
# helpers below prefer the RPC socket when the daemon is reachable and silently
# fall back to the binary in normal terminal sessions where it runs fine.
if [ -f "$BIN_DIR/herdr-rpc" ]; then
  # shellcheck source=/dev/null
  source "$BIN_DIR/herdr-rpc"
fi

# True when herdr_rpc is loaded AND the daemon socket exists.
_herdr_use_rpc() {
  type herdr_rpc >/dev/null 2>&1 && [ -S "${HERDR_SOCK:-$HOME/.config/herdr/herdr.sock}" ]
}

# Per-operation wrappers: try RPC socket first, fall back to binary.

_herdr_agent_get() {  # <name> → JSON
  if _herdr_use_rpc; then
    # NB: the RPC field is "target" (same word the CLI's `herdr agent get
    # <target>` uses), NOT "name" — "name" is rejected with
    # "missing field `target`". The response still nests under .result.agent.name.
    herdr_rpc "agent.get" "$(jq -nc --arg n "$1" '{"target":$n}')"
  else
    herdr agent get "$1" 2>/dev/null
  fi
}

_herdr_tab_close() {  # <tab_id>
  if _herdr_use_rpc; then
    herdr_rpc "tab.close" "$(jq -nc --arg t "$1" '{"tab_id":$t}')" >/dev/null 2>&1 || true
  else
    herdr tab close "$1" >/dev/null 2>&1 || true
  fi
}

_herdr_pane_send_text() {  # <pane_id> <text>
  if _herdr_use_rpc; then
    herdr_rpc "pane.send_text" \
      "$(jq -nc --arg p "$1" --arg t "$2" '{"pane_id":$p,"text":$t}')" >/dev/null 2>&1 || true
  else
    herdr pane send-text "$1" "$2" >/dev/null 2>&1 || true
  fi
}

_herdr_pane_send_keys() {  # <pane_id> <keys>
  if _herdr_use_rpc; then
    herdr_rpc "pane.send_keys" \
      "$(jq -nc --arg p "$1" --arg k "$2" '{"pane_id":$p,"keys":[$k]}')" >/dev/null 2>&1 || true
  else
    herdr pane send-keys "$1" "$2" >/dev/null 2>&1 || true
  fi
}

_herdr_pane_wait_output() {  # <pane_id> <regex> <timeout_ms>
  if _herdr_use_rpc; then
    herdr_rpc "pane.wait_for_output" \
      "$(jq -nc --arg p "$1" --arg r "$2" --argjson t "$3" \
        '{"pane_id":$p,"match":{"type":"regex","value":$r},"timeout":$t,"source":"recent"}')" \
        >/dev/null 2>&1 || true
  else
    herdr pane wait-output "$1" --regex "$2" --timeout "$3" >/dev/null 2>&1 || true
  fi
}

_herdr_pane_read() {  # <pane_id> → pane text on stdout, best-effort
  if _herdr_use_rpc; then
    herdr_rpc "pane.read" \
      "$(jq -nc --arg p "$1" '{"pane_id":$p,"source":"recent"}')" 2>/dev/null \
      | jq -r '.result.read.text // empty' 2>/dev/null || true
  else
    herdr pane read "$1" --source recent 2>/dev/null || true
  fi
}

# _spawn_snapshot <stage> <pane_id>
# Captures the pane's current content. Only appends to the log when the content
# has changed since the last entry (hash dedup). Trims to 1000 entries max.
# Log: $PARLAY_STATE_HOME/spawn-logs/<agent_id>.jsonl  (best-effort, never fatal)
_spawn_snapshot() {
  local stage="$1" pane_id="$2"
  [ -z "$pane_id" ] && return 0
  local log_dir="${PARLAY_STATE_HOME:-$HOME/.parlay}/spawn-logs"
  local log_file="$log_dir/$AGENT_ID.jsonl"
  mkdir -p "$log_dir" 2>/dev/null || return 0

  local content ts hash last_hash
  content=$(_herdr_pane_read "$pane_id") || content=""
  hash=$(printf '%s' "$content" | cksum | awk '{print $1}')
  last_hash=$(tail -1 "$log_file" 2>/dev/null | jq -r '.hash // empty' 2>/dev/null || true)
  [ "$hash" = "$last_hash" ] && return 0   # no change — skip

  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'unknown')
  printf '%s\n' \
    "$(jq -nc --arg ts "$ts" --arg stage "$stage" --arg hash "$hash" --arg content "$content" \
      '{ts:$ts,stage:$stage,hash:$hash,content:$content}')" \
    >> "$log_file" 2>/dev/null || return 0

  # Trim to last 1000 entries (lines in the JSONL file).
  local lc
  lc=$(wc -l < "$log_file" 2>/dev/null || echo 0)
  if [ "${lc:-0}" -gt 1000 ]; then
    local tmp; tmp=$(mktemp "$log_dir/.trim.XXXXXX") && \
      tail -1000 "$log_file" > "$tmp" && mv "$tmp" "$log_file" || rm -f "$tmp"
  fi
}

_herdr_agent_start() {  # <name> <kind> <pane_id> [extra_args...]
  local _as_name="$1" _as_kind="$2" _as_pane="$3"; shift 3
  if _herdr_use_rpc; then
    local _as_args='[]'
    [ $# -gt 0 ] && _as_args=$(printf '%s\n' "$@" | jq -Rsc 'split("\n")[:-1]')
    herdr_rpc "agent.start" \
      "$(jq -nc --arg n "$_as_name" --arg k "$_as_kind" --arg p "$_as_pane" \
        --argjson a "$_as_args" '{"name":$n,"kind":$k,"pane_id":$p,"args":$a}')"
  else
    herdr agent start "$_as_name" --kind "$_as_kind" --pane "$_as_pane" -- "$@" 2>&1
  fi
}

_herdr_agent_prompt() {  # <target> <text>
  if _herdr_use_rpc; then
    herdr_rpc "agent.prompt" \
      "$(jq -nc --arg t "$1" --arg x "$2" '{"target":$t,"text":$x}')" >/dev/null 2>&1
  else
    herdr agent prompt "$1" "$2" >/dev/null 2>&1
  fi
}

_herdr_agent_wait() {  # <name> <until_state> <timeout_ms>
  if _herdr_use_rpc; then
    herdr_rpc "agent.wait" \
      "$(jq -nc --arg n "$1" --arg u "$2" --argjson t "$3" \
        '{"target":$n,"until":[$u],"timeout":$t}')" >/dev/null 2>&1
  else
    herdr agent wait "$1" --until "$2" --timeout "$3" >/dev/null 2>&1
  fi
}

_herdr_agent_prompt_wait() {  # <target> <text> <until_state> <timeout_ms>
  if _herdr_use_rpc; then
    herdr_rpc "agent.prompt" \
      "$(jq -nc --arg t "$1" --arg x "$2" --arg u "$3" --argjson to "$4" \
        '{"target":$t,"text":$x,"wait":{"until":[$u],"timeout":$to}}')" >/dev/null 2>&1
  else
    herdr agent prompt "$1" "$2" --wait --until "$3" --timeout "$4" >/dev/null 2>&1
  fi
}

# Deterministic, readable hex color from an id — a bash port of colorFromId()
# in packages/cli/src/identity-ephemeral.ts (FNV-1a 32-bit, each channel squeezed
# into 40–220 so no tab accent is too dark or too washed out). Same id ⇒ same
# color, so a batch-spawned agent paints the same accent every launch, matching
# the ephemeral-identity convention. Bash arithmetic is 64-bit here, so masking
# with 0xffffffff after each step reproduces the JS `>>> 0` wraparound.
color_from_id() {
  local id="$1"
  local h=2166136261 i=0 c
  local len=${#id}
  while [ "$i" -lt "$len" ]; do
    c=$(printf '%d' "'${id:$i:1}")
    h=$(( (h ^ c) & 0xffffffff ))
    h=$(( (h * 16777619) & 0xffffffff ))
    i=$((i + 1))
  done
  local r=$(( 40 + (h & 0xff) % 181 ))
  local g=$(( 40 + ((h >> 8) & 0xff) % 181 ))
  local b=$(( 40 + ((h >> 16) & 0xff) % 181 ))
  printf '#%02x%02x%02x' "$r" "$g" "$b"
}

# Repo identity of a directory: the absolute, symlink-resolved path of the
# repo's COMMON git dir. Every linked worktree of a repo shares it with the
# primary checkout, and two different repos never share it — so it is the
# right key for "is this worktree actually a worktree of that repo?"
# (robots-d04t). Prints nothing and returns non-zero if not a git repo.
repo_identity() {
  local d="$1" common
  common=$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -n "$common" ] || return 1
  # Resolve symlinks so /var vs /private/var (etc.) can't cause a false mismatch.
  (cd "$common" 2>/dev/null && pwd -P) || printf '%s' "$common"
}

# Resolve a CLAUDE_CODE_OAUTH_TOKEN for a ccjuggler account name.
# Delegates to ccjuggler-resolve (packages/ccjuggler) which checks:
#   macOS keychain (ccjuggler-<name>) → ~/.ccjuggler/<name>/.oauth-token
# Prints the token or exits non-zero with an error message.
resolve_account_token() {
  local account="$1"
  if ! command -v ccjuggler-resolve >/dev/null 2>&1; then
    echo "parlay-spawn: ccjuggler-resolve not found on PATH — run 'bun install' in packages/ccjuggler or add it to PATH" >&2
    return 1
  fi
  ccjuggler-resolve "$account"
}

# Load a launch template file and interpolate variables.
# Variables are passed as VAR_NAME=value pairs and replaced as {{VAR_NAME}}.
# Exits non-zero if template file not found.
load_template() {
  local template_path="$1"
  shift  # remaining args are VAR_NAME=value pairs

  if [ ! -f "$template_path" ]; then
    echo "parlay-spawn: template not found: $template_path" >&2
    return 1
  fi

  local content
  content=$(cat "$template_path")

  # Interpolate each VAR_NAME=value pair
  while [ $# -gt 0 ]; do
    local var_pair="$1"
    local var_name="${var_pair%%=*}"
    local var_value="${var_pair#*=}"
    # Replace {{VAR_NAME}} with the value (preserving special chars via variable expansion)
    content="${content//"{{$var_name}}"/$var_value}"
    shift
  done

  printf '%s' "$content"
}

# resolve_profile <name>
# Looks up <name> in packages/spawn-profiles/profiles.toml and prints
# "<kind>\t<model>" for it. Exits 2 if profiles.toml is missing, python3 (for
# tomllib) is unavailable, or no profile with that name exists — a typo'd
# profile must not silently fall through to the no-model refusal below with a
# confusing message. PARLAY_SPAWN_PROFILES_TOML overrides the catalog path
# (used by tests to point at a fixture instead of the real repo catalog).
resolve_profile() {
  local name="$1"
  local toml="${PARLAY_SPAWN_PROFILES_TOML:-$REPO_DIR/packages/spawn-profiles/profiles.toml}"
  if [ ! -f "$toml" ]; then
    echo "parlay-spawn: --profile $name — no profiles.toml at $toml" >&2
    exit 2
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "parlay-spawn: --profile requires python3 (for tomllib) — not found on PATH" >&2
    exit 2
  fi
  local out
  out=$(python3 - "$toml" "$name" <<'PYEOF' 2>/dev/null
import sys, tomllib
path, name = sys.argv[1], sys.argv[2]
with open(path, "rb") as f:
    data = tomllib.load(f)
for p in data.get("profile", []):
    if p.get("name") == name:
        print(f"{p.get('kind','')}\t{p.get('model','')}")
        break
PYEOF
) || out=""
  if [ -z "$out" ]; then
    echo "parlay-spawn: --profile '$name' not found in $toml" >&2
    exit 2
  fi
  printf '%s' "$out"
}

# require_model
# task-qyu8q: refuses to spawn unless a model was chosen deliberately — no
# implicit "claude session default", no silent sonnet fallback. Satisfied by
# an explicit --model, or by a --profile whose profiles.toml entry names a
# model. Idempotent (safe to call more than once) and side-effect-free besides
# resolving --profile, so it is called once pre-mint on the --ephemeral path
# (matching bead_gate's "gate before the mint" convention — a refusal here
# must leave no seeded store behind) and again, harmlessly, in the shared
# section once PII routing (which can itself set MODEL) has run.
require_model() {
  [ -n "$_MODEL_GATE_DONE" ] && return 0

  if [ -n "${PROFILE:-}" ] && [ -z "${MODEL:-}" ]; then
    local _po _pkind _pmodel
    _po=$(resolve_profile "$PROFILE")
    _pkind="${_po%%"$(printf '\t')"*}"
    _pmodel="${_po#*"$(printf '\t')"}"
    if [ -n "$_pkind" ] && [ "$KIND_FROM_FLAG" != "1" ]; then
      KIND="$_pkind"
    fi
    if [ -n "$_pmodel" ]; then
      MODEL="$_pmodel"
      echo "parlay-spawn: --profile $PROFILE — using model $MODEL (kind=$KIND)" >&2
    fi
  fi

  if [ -n "${MODEL:-}" ]; then
    _MODEL_GATE_DONE=1
    return 0
  fi

  cat >&2 <<EOF
parlay-spawn: refusing to spawn — no model was chosen.

A model/provider must be picked deliberately on every spawn. There is no
implicit default: the launching session's model is never inherited, and there
is no silent sonnet fallback. Choose one:

  --model <model>   For --kind claude: haiku, sonnet, opus, fable, or a full
                    model id (e.g. claude-sonnet-5, claude-opus-5). Run
                    'claude --help' (see the --model entry) for the live
                    alias list — aliases retire, don't trust one written here.
                    For --kind opencode: opencode-go/<model> (paid) or
                    opencode/<model> (free); run 'opencode models' for the
                    live list.
  --profile <name>  A packages/spawn-profiles/profiles.toml profile that pins
                    a model, e.g. --profile claude. See that file's README
                    for the field reference and how to add one.
EOF
  exit 2
}

usage() {
  cat >&2 <<EOF
Usage: parlay-spawn <agent-id> <display-name> <hex-color> <initial-prompt> --model MODEL [--cwd PATH] [--focus]
       parlay-spawn --ephemeral <initial-prompt> --model MODEL [--cwd PATH] [--focus]
       parlay-spawn <id>=<repo> [<id>=<repo> ...] --prompt TEXT --model M [--color HEX] [--focus]

  --model (or --profile naming a model-bearing profile) is REQUIRED on every
  form above — see --model/--profile below.

  agent-id        kebab-slug, stable across restarts (e.g. code-reviewer)
  display-name    tab header text (e.g. "Code Reviewer")
  hex-color       tab accent color (e.g. "#c084fc")
  initial-prompt  the task the spawned agent should work (OPTIONAL with --claim)

  --claim TASK-ID the agent's first turn is 'parlay claim <task-id>', which gives
                  it its identity, enrolls it, and pulls the task from the ticket.
                  Shrinks the startup prompt to one line; the initial-prompt
                  positional becomes optional (the task lives on the ticket).
  --ephemeral     mint a random hash identity (id="eph-XXXXXXXX", derived name,
                  deterministic color) instead of id/name/color positionals.
                  Must be the FIRST arg — cannot combine with an explicit agent-id.
  --cwd PATH      working directory for the spawned claude (default: \$HOME)
  --focus         focus the new terminal (default: launched --no-focus)
  --model MODEL   REQUIRED (unless --profile names one) — pin the agent model.
                  A model must be chosen deliberately on every spawn; there is
                  no implicit default and no silent sonnet fallback. claude:
                  haiku, sonnet, opus, fable, or a full model id (e.g.
                  claude-sonnet-5); opencode: opencode-go/<model>, e.g.
                  opencode-go/deepseek-v4-pro. Run 'claude --help' (see
                  --model) for the live list of claude aliases — they retire,
                  don't trust one written here.
  --profile NAME  use a packages/spawn-profiles/profiles.toml profile, which
                  pins kind + model (see that file's README). Satisfies the
                  model requirement above in place of --model when the named
                  profile has a model field; an explicit --model still wins.
  --kind KIND     agent harness to launch via herdr (default: claude). e.g.
                  --kind opencode spawns the opencode TUI and forwards --model
                  verbatim. Two providers: opencode/<model> is the free tier,
                  opencode-go/<model> is paid (e.g. opencode-go/deepseek-v4-pro,
                  opencode-go/deepseek-v4-flash). Run 'opencode models' for the
                  live list — names retire, so do not trust one written here.
  --mode MODE     delivery mode: report|branch|pr (default: report). Shapes the
                  Definition of Done in the brief and is recorded in meta.
                    report  — do the task, reply when done (default)
                    branch  — commit on parlay/<id>, status done: ready in branch
                    pr      — push + open PR via gh, status done: PR <url>
  --effort LEVEL  effort level forwarded to claude (low|medium|high|xhigh|max);
                  recorded in meta. default: not specified (claude's session default)
  --worktree      create an isolated git worktree at <repo>/.worktrees/parlay-<id>
                  and run the agent there instead of --cwd directly. Requires --cwd
                  to be inside a git repo. Auto-enabled by --mode branch|pr. Uses
                  treehouse if on PATH, else plain git worktree. Recorded in meta.
  --account NAME  spawn the agent under a ccjuggler account (e.g. acc2) to spread
                  Claude usage across accounts. Resolves CLAUDE_CODE_OAUTH_TOKEN from
                  keychain (security find-generic-password -a ccjuggler -s ccjuggler-NAME)
                  or ~/.ccjuggler/NAME/.oauth-token. Injected via herdr --env.
  --workspace ID|LABEL  land the new tab in a herdr workspace. Pass the raw
                  workspace ID (e.g. w6T) or a label (e.g. "firstmate").
                  Label lookup: uses an existing workspace with that name, or
                  creates one. Falls back to \$HERDR_WORKSPACE_ID when not given.
  --pii           declare this task contains personally identifiable information.
                  Blocks free/third-party model APIs (opencode, openrouter) and
                  forces claude (Anthropic). Also labels the bead with
                  'contains-pii' so future relaunches are automatically blocked.
  --no-pii        declare this task contains no PII. Routes to a free opencode
                  model to save on inference and subscription costs, picking the
                  first of PII_FREE_MODEL_PREFERENCE that 'opencode models'
                  actually offers. If opencode is absent or lists no free model,
                  the spawn stays on claude defaults rather than pinning a name
                  that may not exist. Ignored if the bead is already labeled
                  'contains-pii'.
  --bead ID       bind a beads work item to this agent (e.g. task-oyaj). The bead
                  must be OPEN at spawn time; from then on its lifecycle governs
                  the agent's — 'parlay identity --submit' closes it, and once it
                  is closed 'parlay launch <id>' refuses to respawn the agent.
                  REQUIRED for every spawn when beads-required mode is on
                  ([spawn] beads_required in ~/.parlay/config.toml, or
                  PARLAY_SPAWN_BEADS_REQUIRED=1).
  --force         bypass beads-required mode for this spawn (no bead needed)
  --subprocess    use the herdr-free detached-subprocess launcher for this
                  spawn instead of herdr, regardless of PARLAY_SPAWN_LAUNCHER
                  or ~/.parlay/config.toml [spawn] launcher. Escape hatch for
                  herdr's SIGKILL failure mode in headless/no-WindowServer
                  environments. --gascity is the deprecated pre-rename
                  spelling — still accepted, prints a deprecation notice.
                  A third launcher, PARLAY_SPAWN_LAUNCHER=gc (env/config only,
                  no flag yet), routes the launch through Gas City's session
                  runtime via 'parlay gc-spawn' — opt-in, claude-kind only;
                  see 'parlay gc-spawn --help'.

Batch dispatch: when the first arg is an <id>=<repo> pair, every positional is
  treated as one and spawned by re-execing this script in single mode. The <repo>
  becomes that agent's --cwd; the display name is the id and the tab color is
  derived from it (or shared via --color). A shared --prompt is required and given
  to every agent; --model/--profile/--focus/--color/--mode/--effort/--worktree/--account
  are shared too. A model or model-bearing profile is still REQUIRED — each
  child re-checks it independently. A failed pair is reported and skipped, the
  rest still launch, and the batch exits non-zero if any failed.
    parlay-spawn fix-a=~/code/foo add-b=~/code/bar --prompt "Do the thing" --model sonnet

Env: PARLAY_SERVER (default http://localhost:31337)
EOF
  exit 2
}

# ── beads-required gate ─────────────────────────────────────────────────────
# Enforces the two halves of beads-required mode BEFORE anything is registered:
#   1. mode on + no --bead   → refuse (exit 2)
#   2. --bead names a bead that is already closed, or that no store can resolve
#      → refuse (exit 1)
#
# CALL ORDER IS THE WHOLE POINT: this must run before the register-agent POST
# and before any herdr tab / subprocess child exists. A refusal afterwards would
# leave an orphaned registration (and possibly a tab) for an agent that never
# launched — the one failure this gate is shaped to avoid.
#
# Idempotent: the ephemeral path calls it before its mint (so a refusal leaves
# no minted store behind) and the shared call site calls it again for the named
# path; the second call is a no-op rather than a second store round-trip.
bead_gate() {
  [ -n "${_BEAD_GATE_DONE:-}" ] && return 0
  [ "${FORCE:-0}" -eq 1 ] && BEADS_REQUIRED=0
  _BEAD_GATE_DONE=1

  if [ -z "$BEAD_ID" ]; then
    if [ "$BEADS_REQUIRED" -eq 1 ]; then
      if [ -n "$BEADS_REQUIRED_ERROR_TMPL" ]; then
        cat "$BEADS_REQUIRED_ERROR_TMPL" >&2
      else
        echo "parlay-spawn: beads-required mode is ON — every spawn must name an OPEN beads work item." >&2
        echo "  Pass --bead <id>. The bead's lifecycle governs the agent." >&2
      fi
      exit 2
    fi
    return 0
  fi

  if [ -n "${PARLAY_SPAWN_SKIP_BEAD_CHECK:-}" ]; then
    echo "parlay-spawn: PARLAY_SPAWN_SKIP_BEAD_CHECK set — NOT verifying that $BEAD_ID is open." >&2
    return 0
  fi

  # Resolve the bead through its own store wrapper (the id's leading token:
  # task-oyaj → `task`, each wrapper pinning its own BEADS_DIR), falling back
  # to a bare `bd`. Same resolution order as the Go side's workItemStatus —
  # and the reason a bare `bd` is the FALLBACK, not the default: without store
  # context `bd` prints a federation menu instead of answering.
  local _store="${BEAD_ID%%-*}" _bin="" _json="" _status=""
  if [ -n "$_store" ] && [ "$_store" != "$BEAD_ID" ] && command -v "$_store" >/dev/null 2>&1; then
    _bin="$_store"
  elif command -v bd >/dev/null 2>&1; then
    _bin="bd"
  fi
  if [ -z "$_bin" ]; then
    echo "parlay-spawn: WARNING — no store CLI on PATH for $BEAD_ID (tried '$_store', then 'bd');" >&2
    echo "  cannot verify the bead is open. Proceeding with the binding recorded." >&2
    return 0
  fi

  # Every capture below consumes its own exit status explicitly. A bare
  # `_json=$(...)` under `set -euo pipefail` takes the command's status and
  # would abort the whole spawn on a store hiccup (robots-dcag).
  if ! _json="$("$_bin" show "$BEAD_ID" --json 2>/dev/null)"; then
    _json=""
  fi
  if [ -n "$_json" ]; then
    if command -v jq >/dev/null 2>&1; then
      # Match the bead by id anywhere in the document, so an array (what the
      # store wrappers emit), a bare object, or a wrapped envelope all work.
      _status="$(printf '%s' "$_json" | jq -r --arg id "$BEAD_ID" '[.. | objects | select(.id? == $id)] | .[0].status // empty' 2>/dev/null)" || _status=""
    else
      _status="$(printf '%s' "$_json" | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)" || _status=""
    fi
  fi

  case "$(printf '%s' "$_status" | tr '[:upper:]' '[:lower:]')" in
    closed|done|completed|resolved)
      echo "parlay-spawn: bead $BEAD_ID is $_status — refusing to spawn." >&2
      echo "  A closed bead means the work is over: the agent would be registered, launch," >&2
      echo "  and be refused its first relaunch. Re-open the bead, or spawn against an open one." >&2
      exit 1
      ;;
    "")
      echo "parlay-spawn: could not read a status for $BEAD_ID ('$_bin show $BEAD_ID --json')." >&2
      echo "  Refusing to spawn: a bead this script cannot resolve cannot govern the agent's" >&2
      echo "  lifecycle, and a typo'd id would bind the agent to nothing. Check the id, or set" >&2
      echo "  PARLAY_SPAWN_SKIP_BEAD_CHECK=1 to spawn without verifying." >&2
      exit 1
      ;;
  esac
  echo "parlay-spawn: bead $BEAD_ID is $_status — binding it to this agent." >&2
}

# ── Ephemeral hash-identity path ────────────────────────────────────────────
# `parlay-spawn --ephemeral "<prompt>" [--cwd PATH] [--model MODEL] [--focus]`
# mints a random hash identity (id="eph-XXXXXXXX", derived name, deterministic
# color) instead of taking id/name/color positionals. Mutually exclusive with an
# explicit agent-id: --ephemeral must be the FIRST arg. The mint step seeds the
# store (context.json + identity.md with `ephemeral: true`), so the ephemeral
# path skips the trailing named-agent --register (mint already did it).
EPHEMERAL=0
if [ "${1:-}" = "--ephemeral" ]; then
  EPHEMERAL=1
  shift
  [ $# -lt 1 ] && { echo "parlay-spawn: --ephemeral requires a prompt" >&2; usage; }
  PROMPT="$1"; shift

  # Parse the ephemeral tail flags first — --cwd/--model must be known before the
  # mint so they land in the seeded frontmatter.
  CWD="$HOME"
  FOCUS_FLAG="--no-focus"
  MODEL=""
  PROFILE=""
  MODE="report"
  EFFORT=""
  KIND="claude"
  PII=""
  WANT_WORKTREE=0
  WORKSPACE="${HERDR_WORKSPACE_ID:-}"
  CLAIM=""
  IN_PLACE_PANE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd)       CWD="$2"; shift 2 ;;
      --focus)     FOCUS_FLAG="--focus"; shift ;;
      --model)     MODEL="$2"; shift 2 ;;
      --profile)   PROFILE="$2"; shift 2 ;;
      --mode)      MODE="$2"; shift 2 ;;
      --effort)    EFFORT="$2"; shift 2 ;;
      --kind)      KIND="$2"; KIND_FROM_FLAG=1; shift 2 ;;
      --pii)       PII=1; shift ;;
      --no-pii)    PII=0; shift ;;
      --worktree)  WANT_WORKTREE=1; shift ;;
      --account)   ACCOUNT="$2"; shift 2 ;;
      --subprocess) LAUNCHER="subprocess"; shift ;;
      --gascity)   LAUNCHER="subprocess"; echo "parlay-spawn: WARNING — --gascity is deprecated (renamed --subprocess); still works until the next release." >&2; shift ;;
      --bead)      BEAD_ID="$2"; shift 2 ;;
      --force)     FORCE=1; shift ;;
      --ephemeral) echo "parlay-spawn: --ephemeral given twice" >&2; usage ;;
      *) echo "parlay-spawn: unknown arg: $1" >&2; usage ;;
    esac
  done

  # Gate before the mint: a refusal here leaves no seeded store behind.
  require_model
  bead_gate

  # Mint id/name/color and seed the store. Prints a TAB-separated "<id>\t<name>\t<color>"
  # line (name contains a space, so tabs keep the three fields unambiguous).
  MINT=$(PARLAY_SERVER="$PARLAY" parlay identity --mint-ephemeral --cwd "$CWD" ${MODEL:+--model "$MODEL"}) \
    || { echo "parlay-spawn: --ephemeral mint failed (is the parlay CLI on PATH?)" >&2; exit 1; }
  AGENT_ID=$(printf '%s' "$MINT" | cut -f1)
  NAME=$(printf '%s' "$MINT" | cut -f2)
  COLOR=$(printf '%s' "$MINT" | cut -f3)
  if [ -z "$AGENT_ID" ] || [ -z "$NAME" ] || [ -z "$COLOR" ]; then
    echo "parlay-spawn: --ephemeral mint returned an unusable identity: '$MINT'" >&2
    exit 1
  fi
  echo "parlay-spawn: minted ephemeral identity $AGENT_ID ($NAME, $COLOR)" >&2

  # The ephemeral path skips the trailing named-agent --register (the mint
  # already seeded the store), so a --bead binding has to be recorded here or
  # it is lost. Re-registering with --ephemeral keeps the ephemeral marker;
  # every other field is left untouched (--register only writes what it is
  # given, over the frontmatter the mint just wrote).
  if [ -n "$BEAD_ID" ]; then
    PARLAY_SERVER="$PARLAY" parlay identity --register --agent "$AGENT_ID" --ephemeral --bead "$BEAD_ID" >/dev/null \
      || echo "parlay-spawn: WARNING — could not record bead $BEAD_ID on $AGENT_ID; its lifecycle will NOT govern this agent." >&2
  fi
fi

# ── Batch dispatch (thin loop) ──────────────────────────────────────────────
# When the FIRST arg is an `id=repo` pair — it contains an '=' and the id-part
# (before the '=') has no '/' — treat every positional as one pair and spawn each
# by re-execing this script in single mode. This is the parlay port of firstmate's
# fm-spawn.sh batch (`fm-spawn.sh fix-a=projects/foo add-b=projects/bar`): the loop
# lives here in bash so callers never hand-write it. A single-task invocation
# never carries an '=' in arg one (agent ids are bare kebab slugs), and an id that
# contains '/' is not a pair, so both fall straight through to the single path.
#
# Differences from firstmate: there is no per-id brief file, so a shared --prompt
# is REQUIRED and handed to every agent; the <repo> becomes each agent's --cwd; the
# display name is the id and the color is derived from it (colorFromId), or set for
# the whole batch with --color. --model/--focus are forwarded to every pair.
# A failed pair is reported and skipped; the rest still launch; exit is non-zero if
# any pair failed (rc=1 spawn failure, rc=2 bad arg / missing --prompt).
if [ "$EPHEMERAL" -eq 0 ] && [ $# -gt 0 ]; then
  _first="$1"
  case "$_first" in
    -* ) : ;;                              # a flag, not a pair → not batch
    *=* )
      _idpart="${_first%%=*}"
      case "$_idpart" in
        */* ) : ;;                          # slash in id-part → not a pair
        * )
          # Batch mode. Separate pairs (positionals) from shared flags.
          PAIRS=()
          BATCH_PROMPT=""
          BATCH_MODEL=""
          BATCH_PROFILE=""
          BATCH_COLOR=""
          BATCH_FOCUS="--no-focus"
          BATCH_MODE="report"
          BATCH_EFFORT=""
          BATCH_KIND=""
          BATCH_PII=""
          BATCH_WORKTREE=0
          BATCH_ACCOUNT="$ACCOUNT"
          BATCH_SUBPROCESS=0
          # A batch --bead is SHARED by every pair, exactly like --account and
          # --model: all of them are working one bead. Whichever agent submits
          # first closes it, and every sibling's relaunch is refused from then
          # on — that is the mode's contract, not an accident of forwarding.
          # Spawn one batch per bead if that is not what you want.
          BATCH_BEAD=""
          while [ $# -gt 0 ]; do
            case "$1" in
              --prompt)    BATCH_PROMPT="$2"; shift 2 ;;
              --model)     BATCH_MODEL="$2"; shift 2 ;;
              --profile)   BATCH_PROFILE="$2"; shift 2 ;;
              --color)     BATCH_COLOR="$2"; shift 2 ;;
              --focus)     BATCH_FOCUS="--focus"; shift ;;
              --mode)      BATCH_MODE="$2"; shift 2 ;;
              --effort)    BATCH_EFFORT="$2"; shift 2 ;;
              --kind)      BATCH_KIND="$2"; shift 2 ;;
              --pii)       BATCH_PII="--pii"; shift ;;
              --no-pii)    BATCH_PII="--no-pii"; shift ;;
              --worktree)  BATCH_WORKTREE=1; shift ;;
              --account)   BATCH_ACCOUNT="$2"; shift 2 ;;
              --subprocess) BATCH_SUBPROCESS=1; shift ;;
              --gascity)   BATCH_SUBPROCESS=1; echo "parlay-spawn: WARNING — --gascity is deprecated (renamed --subprocess); still works until the next release." >&2; shift ;;
              --bead)      BATCH_BEAD="$2"; shift 2 ;;
              --cwd)    echo "parlay-spawn: --cwd is not valid in batch mode (each id=repo pair supplies its own cwd via <repo>)" >&2; exit 2 ;;
              --ephemeral) echo "parlay-spawn: --ephemeral cannot combine with batch id=repo pairs" >&2; exit 2 ;;
              -*)       echo "parlay-spawn: unknown batch flag: $1" >&2; exit 2 ;;
              *)        PAIRS+=("$1"); shift ;;
            esac
          done

          if [ -z "$BATCH_PROMPT" ]; then
            echo "parlay-spawn: batch dispatch requires a shared --prompt (the brief handed to every spawned agent)" >&2
            exit 2
          fi

          # Gate the shared bead once, here, rather than letting every child
          # discover the same refusal separately: a missing or closed bead is a
          # property of the batch, and N identical failures read as N problems.
          # Each child still re-checks (it is a fresh process with its own
          # --bead), so this is an early, clearer refusal, not the only one.
          BEAD_ID="$BATCH_BEAD"
          bead_gate

          rc=0
          for pair in ${PAIRS[@]+"${PAIRS[@]}"}; do
            case "$pair" in
              *=*) : ;;
              *) echo "parlay-spawn: batch dispatch expects every argument as id=repo; got '$pair'" >&2; rc=2; continue ;;
            esac
            _bid="${pair%%=*}"
            _brepo="${pair#*=}"
            # Expand a leading ~ so `id=~/code/foo` resolves (mid-word tildes are
            # not expanded by the shell).
            # shellcheck disable=SC2088  # literal ~ case patterns, expansion handled below
            case "$_brepo" in
              "~")   _brepo="$HOME" ;;
              "~/"*) _brepo="$HOME/${_brepo#\~/}" ;;
            esac
            _bcolor="${BATCH_COLOR:-$(color_from_id "$_bid")}"
            _shared=(--cwd "$_brepo")
            [ -n "$BATCH_MODEL" ] && _shared+=(--model "$BATCH_MODEL")
            [ -n "$BATCH_PROFILE" ] && _shared+=(--profile "$BATCH_PROFILE")
            [ "$BATCH_FOCUS" = "--focus" ] && _shared+=(--focus)
            _shared+=(--mode "$BATCH_MODE")
            [ -n "$BATCH_EFFORT" ] && _shared+=(--effort "$BATCH_EFFORT")
            [ -n "$BATCH_KIND" ] && _shared+=(--kind "$BATCH_KIND")
            [ -n "$BATCH_PII" ] && _shared+=("$BATCH_PII")
            [ "$BATCH_WORKTREE" -eq 1 ] && _shared+=(--worktree)
            [ -n "$BATCH_ACCOUNT" ] && _shared+=(--account "$BATCH_ACCOUNT")
            [ "$BATCH_SUBPROCESS" -eq 1 ] && _shared+=(--subprocess)
            [ -n "$BATCH_BEAD" ] && _shared+=(--bead "$BATCH_BEAD")
            if "$SELF" "$_bid" "$_bid" "$_bcolor" "$BATCH_PROMPT" ${_shared[@]+"${_shared[@]}"}; then
              :
            else
              echo "batch: FAILED to spawn $_bid ($_brepo)" >&2
              rc=1
            fi
          done
          exit "$rc"
          ;;
      esac
      ;;
  esac
fi

if [ "$EPHEMERAL" -eq 0 ]; then
[ $# -lt 3 ] && usage

AGENT_ID="$1"; NAME="$2"; COLOR="$3"; shift 3

# The 4th positional is the initial-prompt, OPTIONAL when --claim is used (the
# task then lives on the ticket, not here). A 4th arg starting with '-' is the
# start of the flag section, not a prompt.
PROMPT=""
case "${1:-}" in
  ""|-*) : ;;
  *)     PROMPT="$1"; shift ;;
esac

CWD="$HOME"
FOCUS_FLAG="--no-focus"
MODEL=""
PROFILE=""
MODE="report"
EFFORT=""
KIND="claude"
PII=""
WANT_WORKTREE=0
CLAIM=""
IN_PLACE_PANE=""
WORKSPACE="${HERDR_WORKSPACE_ID:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd)       CWD="$2"; shift 2 ;;
    --focus)     FOCUS_FLAG="--focus"; shift ;;
    --model)     MODEL="$2"; shift 2 ;;
    --profile)   PROFILE="$2"; shift 2 ;;
    --mode)      MODE="$2"; shift 2 ;;
    --effort)    EFFORT="$2"; shift 2 ;;
    --kind)      KIND="$2"; KIND_FROM_FLAG=1; shift 2 ;;
    --pii)       PII=1; shift ;;
    --no-pii)    PII=0; shift ;;
    --worktree)  WANT_WORKTREE=1; shift ;;
    --account)   ACCOUNT="$2"; shift 2 ;;
    --claim)     CLAIM="$2"; shift 2 ;;
    --pane)      IN_PLACE_PANE="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --subprocess) LAUNCHER="subprocess"; shift ;;
    --gascity)   LAUNCHER="subprocess"; echo "parlay-spawn: WARNING — --gascity is deprecated (renamed --subprocess); still works until the next release." >&2; shift ;;
    --bead)      BEAD_ID="$2"; shift 2 ;;
    --force)     FORCE=1; shift ;;
    --ephemeral) echo "parlay-spawn: --ephemeral must be the first argument (cannot combine with an explicit agent-id)" >&2; usage ;;
    *) echo "parlay-spawn: unknown arg: $1" >&2; usage ;;
  esac
done

# Need either an inline prompt or a --claim task-id to give the agent work.
if [ -z "$PROMPT" ] && [ -z "$CLAIM" ]; then
  echo "parlay-spawn: give the agent work — an initial-prompt positional or --claim <task-id>" >&2
  usage
fi
fi

# Validate agent id shape (kebab-slug).
if ! printf '%s' "$AGENT_ID" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "parlay-spawn: agent-id must be a kebab-slug (got: '$AGENT_ID')" >&2
  exit 2
fi

# beads-required gate for the named path (a no-op if the ephemeral path above
# already ran it). Deliberately placed here: after the args are known, and
# before the worktree lease, the register-agent POST, and any launcher — every
# one of which leaves state behind that a later refusal would strand.
bead_gate

# PII routing: label bead if --pii, check existing label, enforce or prefer models.
pii_apply_bead_label   # label the bead if PII=1 and BEAD_ID is set
pii_check_bead_label   # set PII=1 if bead already has contains-pii (overrides --no-pii)
pii_enforce            # PII=1: block non-claude harnesses
pii_route_model        # PII=0: prefer free models when KIND/MODEL are at defaults

# task-qyu8q: no implicit model. A no-op if the --ephemeral path already
# satisfied this pre-mint; otherwise resolves --profile (if given) and refuses
# to spawn if MODEL is still empty — before the worktree lease, the
# register-agent POST, and any launcher.
require_model

# branch/pr delivery modes require worktree isolation — auto-enable.
if [ "$MODE" = "branch" ] || [ "$MODE" = "pr" ]; then
  WANT_WORKTREE=1
fi

# Early git validation: if --worktree, confirm CWD is inside a git repo before
# registering the agent (avoids an orphaned tab on failure).
WORKTREE_PATH=""
PROJECT_PATH=""
TREEHOUSE_LEASED_PATH=""
if [ "$WANT_WORKTREE" -eq 1 ]; then
  PROJECT_PATH=$(cd "$CWD" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || {
    echo "parlay-spawn: --worktree requires --cwd to be inside a git repo (got: '$CWD')" >&2
    exit 1
  }
  WORKTREE_PATH="$PROJECT_PATH/.worktrees/parlay-$AGENT_ID"
fi

json_escape() { printf '%s' "$1" | jq -Rs .; }

# POSIX single-quote a value so a shell treats every character in it literally.
# The startup prompt hands the agent a `parlay listen` command to paste, and
# $NAME is arbitrary prose (often a ticket title verbatim); inside double quotes
# `$(…)`, backticks and `$VAR` are live, so a name mentioning `$( )` used to be
# command-substituted on paste (robots-2h4n). An embedded quote is closed,
# escaped, and reopened ('\'') — the one form single-quoting cannot express.
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# Resolve a herdr workspace ID from either an ID or a label.
# If the value looks like a workspace ID (starts with 'w' followed by
# alphanumerics) it is used as-is. Otherwise it is treated as a label:
# the existing workspace with that label is returned, or a new one is
# created. Prints the resolved ID; exits non-zero on RPC failure.
resolve_workspace() {
  local want="$1"
  # Looks like a raw ID — pass through unchanged.
  if printf '%s' "$want" | grep -qE '^w[A-Za-z0-9]+$'; then
    printf '%s' "$want"
    return 0
  fi
  # Label lookup: find a workspace whose label matches exactly.
  local list id
  list=$(herdr workspace list 2>/dev/null) || { echo "parlay-spawn: herdr workspace list failed" >&2; return 1; }
  id=$(printf '%s' "$list" | jq -r --arg l "$want" \
    '.result.workspaces[] | select(.label == $l) | .workspace_id' 2>/dev/null | head -1)
  if [ -n "$id" ]; then
    echo "parlay-spawn: workspace '$want' resolved to $id" >&2
    printf '%s' "$id"
    return 0
  fi
  # Not found — create it.
  echo "parlay-spawn: workspace '$want' not found, creating..." >&2
  local created
  created=$(herdr workspace create --label "$want" --no-focus 2>/dev/null) || \
    { echo "parlay-spawn: herdr workspace create '$want' failed" >&2; return 1; }
  id=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty' 2>/dev/null)
  [ -n "$id" ] || { echo "parlay-spawn: could not parse workspace_id from create response" >&2; return 1; }
  echo "parlay-spawn: created workspace '$want' → $id" >&2
  printf '%s' "$id"
}

# Refuse a duplicate: if a herdr agent with this id is already live, creating a
# second one leaves two identically-labeled "edgar" tabs (one a ghost) and is
# confusing. Reclaim the name first (kill the old session + close its tab) or use
# a different id. This is the up-front guard against same-name panes.
if _herdr_use_rpc || command -v herdr >/dev/null 2>&1; then
  EXISTING_AGENT=$(_herdr_agent_get "$AGENT_ID" | jq -r '.result.agent.name // empty' 2>/dev/null || true)
  if [ -n "$EXISTING_AGENT" ]; then
    echo "parlay-spawn: a herdr agent named '$AGENT_ID' already exists — refusing to create a duplicate." >&2
    echo "  Reclaim the name first: 'herdr agent list' to find it, kill its process, then 'herdr tab close <its tab>'." >&2
    echo "  Or spawn under a different agent-id." >&2
    exit 1
  fi
fi

# herdr contract gate (robots-4v2e): assert herdr still exposes every subcommand
# and flag we're about to shell out to, BEFORE registering the agent or creating
# a tab. A drifted herdr fails here with a precise "no longer accepts --X" line
# instead of a cryptic mid-dispatch rollback. Escape hatch:
# PARLAY_SPAWN_SKIP_CONTRACT=1 (emergency-only; fix the drift and remove it).
if [ "${PARLAY_SPAWN_SKIP_CONTRACT:-0}" != "1" ] && command -v herdr_contract_check >/dev/null 2>&1; then
  # set -e safe: capture exit code via if/else so set -e doesn't fire when the
  # contract check returns 2 (UNVERIFIED — herdr server unreachable but no drift).
  if herdr_contract_check; then
    _contract_rc=0
  else
    _contract_rc=$?
  fi
  if [ "$_contract_rc" -eq 1 ]; then
    echo "parlay-spawn: herdr contract check failed — refusing to dispatch into a drifted herdr." >&2
    echo "  Re-run 'pipeline-selftest' after fixing, or set PARLAY_SPAWN_SKIP_CONTRACT=1 to bypass (emergency only)." >&2
    exit 1
  elif [ "$_contract_rc" -eq 2 ]; then
    echo "parlay-spawn: herdr contract unverified (server unreachable during preflight) — proceeding; dispatch may fail if herdr API has drifted." >&2
  fi
fi

echo "parlay-spawn: registering agent '$AGENT_ID' with Parlay at $PARLAY ..." >&2

# 1. Register the agent so the tab exists.
curl -s -X POST "$PARLAY/api/chat/register-agent" \
  -H "Content-Type: application/json" \
  -d "{\"id\":$(json_escape "$AGENT_ID"),\"name\":$(json_escape "$NAME"),\"color\":$(json_escape "$COLOR")}" \
  >/dev/null || { echo "parlay-spawn: register-agent failed — is Pulse running on $PARLAY?" >&2; exit 1; }

# 2. Post a hello reply so the tab goes live immediately.
curl -s -X POST "$PARLAY/api/chat/reply" \
  -H "Content-Type: application/json" \
  -d "{\"text\":$(json_escape "Spawning… arming monitor and starting on the task."),\"agent\":$(json_escape "$AGENT_ID"),\"name\":$(json_escape "$NAME"),\"color\":$(json_escape "$COLOR")}" \
  >/dev/null || true

# 2b. Write context.json for the agent (JSON file as primary for agent lookup).
AGENT_DIR="$HOME/.parlay/agents/$AGENT_ID"
mkdir -p "$AGENT_DIR"
jq -n --arg id "$AGENT_ID" --arg name "$NAME" --arg color "$COLOR" \
  '{id: $id, name: $name, color: $color}' > "$AGENT_DIR/context.json" || true
# Write a session-start sentinel (epoch seconds). The say-guard reads this to
# distinguish handoffs created in a prior session ("inherited") from ones this
# agent created itself. Overwrite on every spawn so the timestamp is always fresh.
date +%s > "$AGENT_DIR/session-start" || true

# 2c. Worktree setup (fold §3.3). When --worktree (or mode=branch/pr), create an
#   isolated git worktree at <repo>/.worktrees/parlay-<id> and override CWD to it.
#   Treehouse is optional: probe PATH, use `treehouse get --lease` if present,
#   fall back to plain git worktree. ISOLATION is the hard rule: agent runs ONLY in
#   the worktree, never the primary checkout.
if [ "$WANT_WORKTREE" -eq 1 ]; then
  mkdir -p "$PROJECT_PATH/.worktrees"

  # Try treehouse first (firstmate-only tool, gracefully absent on minis).
  #
  # robots-d04t: treehouse has no --repo flag — it picks its pool from the
  # PROCESS cwd. Running it inherited from the CALLER's shell, so spawning
  # `--cwd ~/code/herdr-web` from inside a firstmate worktree leased a
  # *firstmate* worktree and launched the agent in the wrong repo, silently.
  # Always run it with cwd = $PROJECT_PATH (the repo --cwd resolved to), and
  # verify the repo identity of whatever it hands back before trusting it.
  #
  # robots-n8d9: `treehouse get` RESETS the slot it hands out (checks
  # origin/main out over whatever branch was there), and its own eligibility
  # rules are blind to a live agent sitting in a clean slot — it reclaimed one
  # out from under a running agent belonging to a different firstmate home.
  # bin/parlay-treehouse-guard sweeps the pool first and takes a protective
  # lease on every still-occupied slot, which treehouse does honor. Best
  # effort: a guard failure must never block a spawn.
  _wt_created=0
  if command -v treehouse >/dev/null 2>&1; then
    if [ -x "$BIN_DIR/parlay-treehouse-guard" ]; then
      "$BIN_DIR/parlay-treehouse-guard" "$PROJECT_PATH" || true
    fi
    _th_out=$(cd "$PROJECT_PATH" && treehouse get --lease "parlay-$AGENT_ID" 2>/dev/null) && {
      _th_path=$(printf '%s' "$_th_out" | tr -d '[:space:]')
      if [ -d "$_th_path" ]; then
        if [ "$(repo_identity "$_th_path")" = "$(repo_identity "$PROJECT_PATH")" ]; then
          WORKTREE_PATH="$_th_path"
          _wt_created=1
          # Recorded ONLY on a verified treehouse lease (never the plain git
          # worktree fallback below) — this is what the subprocess launch branch
          # passes to `parlay-bin subprocess-spawn --worktree-path`, so
          # subprocess-stop knows to `treehouse return` it and a plain
          # git-worktree agent is never mistaken for a leased one.
          TREEHOUSE_LEASED_PATH="$WORKTREE_PATH"
          echo "parlay-spawn: worktree via treehouse at $WORKTREE_PATH" >&2
        else
          echo "parlay-spawn: WRONG-REPO WORKTREE — treehouse handed back $_th_path," >&2
          echo "  which belongs to $(repo_identity "$_th_path") but --cwd resolved to $PROJECT_PATH" >&2
          echo "  ($(repo_identity "$PROJECT_PATH")). Rejecting it and falling back to plain git worktree." >&2
          (cd "$PROJECT_PATH" && treehouse return "$_th_path" >/dev/null 2>&1) || true
        fi
      fi
    } || true
  fi

  # Plain git worktree fallback (or if treehouse did not produce a valid path).
  if [ "$_wt_created" -eq 0 ]; then
    if git -C "$PROJECT_PATH" worktree list --porcelain 2>/dev/null \
        | grep -qF "worktree $WORKTREE_PATH"; then
      echo "parlay-spawn: reusing existing worktree at $WORKTREE_PATH" >&2
    else
      # branch/pr: create named branch parlay/<id>; report: detach (no branch needed).
      if [ "$MODE" = "branch" ] || [ "$MODE" = "pr" ]; then
        git -C "$PROJECT_PATH" worktree add "$WORKTREE_PATH" -b "parlay/$AGENT_ID" 2>/dev/null \
          || git -C "$PROJECT_PATH" worktree add "$WORKTREE_PATH" "parlay/$AGENT_ID" \
          || { echo "parlay-spawn: git worktree add failed for $WORKTREE_PATH" >&2; exit 1; }
      else
        git -C "$PROJECT_PATH" worktree add --detach "$WORKTREE_PATH" \
          || { echo "parlay-spawn: git worktree add failed for $WORKTREE_PATH" >&2; exit 1; }
      fi
      echo "parlay-spawn: worktree created at $WORKTREE_PATH (project: $PROJECT_PATH)" >&2
    fi
  fi

  # ISOLATION: sanity — worktree path must not be the primary checkout.
  _wt_real=$(cd "$WORKTREE_PATH" 2>/dev/null && pwd -P)
  _proj_real=$(cd "$PROJECT_PATH" 2>/dev/null && pwd -P)
  if [ "$_wt_real" = "$_proj_real" ]; then
    echo "parlay-spawn: ISOLATION FAILURE — worktree resolved to primary checkout ($PROJECT_PATH); aborting." >&2
    exit 1
  fi

  # IDENTITY (robots-d04t): hard post-condition — the worktree we are about to
  # launch the agent in must be a worktree of the SAME repo --cwd resolved to.
  # Getting this wrong is silent and expensive (a full agent run spent in an
  # unrelated repo, possibly leaving commits/branches there), so refuse loudly.
  _wt_repo=$(repo_identity "$WORKTREE_PATH") || _wt_repo=""
  _proj_repo=$(repo_identity "$PROJECT_PATH") || _proj_repo=""
  if [ -z "$_wt_repo" ] || [ "$_wt_repo" != "$_proj_repo" ]; then
    echo "parlay-spawn: REPO MISMATCH — refusing to launch in the wrong repository." >&2
    echo "  --cwd resolved to project: $PROJECT_PATH (git dir: ${_proj_repo:-<none>})" >&2
    echo "  worktree resolved to:      $WORKTREE_PATH (git dir: ${_wt_repo:-<none>})" >&2
    echo "  These are different repos. Aborting instead of burning an agent run in the wrong one." >&2
    exit 1
  fi

  # Override CWD to the worktree for all downstream steps.
  CWD="$WORKTREE_PATH"
fi

# 3. Compose the Definition of Done per delivery mode (fold §3.5).
case "$MODE" in
  branch) DOD="Commit your work on branch 'parlay/$AGENT_ID'. When done, run: parlay status done \"ready in branch parlay/$AGENT_ID\"" ;;
  pr)     DOD="Push your branch 'parlay/$AGENT_ID' and open a PR via 'gh pr create'. When done, run: parlay status done \"PR <url>\"" ;;
  *)      DOD="Do the task, then reply your result with 'reply \"<summary>\"' and run: parlay status done \"<one-line summary>\"" ;;
esac

# 3a. Worktree setup block for the brief (only when --worktree active).
SETUP_BLOCK=""
if [ "$WANT_WORKTREE" -eq 1 ]; then
  SETUP_BLOCK=$(printf '%s' "
## Setup

You are running in an isolated git worktree — NOT the primary checkout.
Assert isolation BEFORE any git operation:

  pwd -P                         # must resolve to: $WORKTREE_PATH
  git rev-parse --show-toplevel  # must resolve to: $WORKTREE_PATH

If EITHER resolves to $PROJECT_PATH (the primary checkout), STOP immediately:
  parlay status blocked \"isolation failure — running in primary checkout, not worktree\"
Never commit, branch, or push from the primary checkout.
")
fi

# 3. Compose the startup prompt.
#    --claim path (idea-tm0): the brief shrinks to a single command. 'parlay
#    claim <task-id>' hands the agent its identity, enrolls it, and returns the
#    task from the ticket — so the enrollment prose and the task both move
#    off this prompt. The profile env injected on the tab lets claim resolve
#    id/name/color/model without positional prose.
if [ -n "${CLAIM:-}" ]; then
  TEMPLATES_DIR="$BIN_DIR/../launch-templates"
  STARTUP_PROMPT=$(load_template "$TEMPLATES_DIR/claim.txt" \
    "AGENT_ID=$AGENT_ID" \
    "CLAIM=$CLAIM" \
    "SETUP_BLOCK=$SETUP_BLOCK") || exit 1
else
# Default path: full enrollment block + inline task contract (fold §3.1/§3.6).
#    The fresh claude processes this as its first turn, so it arms the Monitor
#    (making the tab "listening") and posts a ready reply before/while working.
# Build the arm-command out of band: every value single-quoted for the shell,
# then the whole command JSON-quoted for the Monitor({}) literal (robots-2h4n).
  MONITOR_CMD_JSON=$(json_escape "PARLAY_SERVER=$(shell_quote "$PARLAY") parlay listen --agent $(shell_quote "$AGENT_ID") --name $(shell_quote "$NAME") --color $(shell_quote "$COLOR")")

  TEMPLATES_DIR="$BIN_DIR/../launch-templates"
  STARTUP_PROMPT=$(load_template "$TEMPLATES_DIR/default.txt" \
    "PARLAY=$PARLAY" \
    "AGENT_ID=$AGENT_ID" \
    "NAME=$NAME" \
    "COLOR=$COLOR" \
    "MONITOR_CMD_JSON=$MONITOR_CMD_JSON" \
    "SETUP_BLOCK=$SETUP_BLOCK" \
    "PROMPT=$PROMPT" \
    "DOD=$DOD") || exit 1
fi

# 4. Pre-trust the workdir so the spawned claude never stalls on the folder
#    trust dialog (captain's standing policy 2026-07-13: always trust).
CLAUDE_JSON="$HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ] && command -v jq >/dev/null; then
  _tmp=$(mktemp)
  if jq --arg p "$CWD" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$CLAUDE_JSON" > "$_tmp"; then
    mv "$_tmp" "$CLAUDE_JSON"
  else
    rm -f "$_tmp"; echo "parlay-spawn: warn: could not pre-trust $CWD (jq failed)" >&2
  fi
fi

# 4a. Collect project-level env vars from .env / .envrc in the resolved CWD.
#     .env: parsed statically (no shell execution) — forward KEY=VALUE lines.
#     .envrc: run via direnv (if on PATH) with a clean baseline env so only
#     vars the project adds are forwarded. Never blanket-forward the captain's env.
PROJECT_ENV_FLAGS=()

if [ -f "$CWD/.env" ]; then
  _env_count=0
  while IFS= read -r _eline || [ -n "$_eline" ]; do
    case "$_eline" in ''|'#'*) continue ;; esac
    _eline="${_eline#export }"          # strip leading 'export ' if present
    _ekey="${_eline%%=*}"
    if printf '%s' "$_ekey" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
      PROJECT_ENV_FLAGS+=(--env "$_eline")
      _env_count=$((_env_count + 1))
    fi
  done < "$CWD/.env"
  [ "$_env_count" -gt 0 ] && echo "parlay-spawn: forwarding $_env_count var(s) from $CWD/.env" >&2
fi

if [ -f "$CWD/.envrc" ] && command -v direnv >/dev/null 2>&1; then
  # Run direnv with a minimal baseline so the diff gives only project additions.
  _direnv_count=0
  while IFS= read -r _dline; do
    _dkey="${_dline%%=*}"
    case "$_dkey" in DIRENV_*|HOME|PATH|PWD|SHLVL|_|'') continue ;; esac
    PROJECT_ENV_FLAGS+=(--env "$_dline")
    _direnv_count=$((_direnv_count + 1))
  done < <(env -i HOME="$HOME" PATH="$PATH" direnv exec "$CWD" env 2>/dev/null \
             | grep -v '^DIRENV_\|^HOME=\|^PATH=\|^SHLVL=\|^_=\|^PWD=')
  [ "$_direnv_count" -gt 0 ] && echo "parlay-spawn: forwarding $_direnv_count var(s) from $CWD/.envrc via direnv" >&2
fi

# 5. Launch a fresh, TOP-LEVEL claude in a detached herdr terminal.
#    herdr 0.7.5 split the old monolithic launch call: `herdr tab create` now
#    owns --cwd/--env/--focus/--label/--workspace, while `herdr agent start`
#    only starts a validated --kind inside an *existing* --pane and passes
#    args after `--` straight to that binary — no shell wrapper is possible
#    anymore, so we can no longer `exec claude ...` via `bash -lc`.
#    We replicate the old wrapper's env-unset by pre-clearing the
#    nesting-marker vars directly in the pane before starting the agent
#    (empty-string via --env is NOT enough — the guard checks presence, so
#    we must `unset` — and new panes inherit the herdr server's own
#    CLAUDECODE/CLAUDE_CODE_* env, confirmed empirically).
# Resolve workspace label → ID before tab creation (no ghost tab on failure).
if [ -n "$WORKSPACE" ]; then
  WORKSPACE=$(resolve_workspace "$WORKSPACE") || exit 1
fi

echo "parlay-spawn: launching detached $KIND agent via $LAUNCHER (cwd=$CWD, $FOCUS_FLAG) ..." >&2

# Resolve account token if --account was given, before tab creation so there
# is no ghost tab to clean up on a bad keychain lookup.
OAUTH_ENV_FLAG=()
if [ -n "$ACCOUNT" ]; then
  _token=$(resolve_account_token "$ACCOUNT") || exit 1
  OAUTH_ENV_FLAG=(--env "CLAUDE_CODE_OAUTH_TOKEN=$_token")
  echo "parlay-spawn: using account '$ACCOUNT' (token resolved)" >&2
fi

if [ "$LAUNCHER" = "gc" ]; then
# gc launcher (spawn-lift unit 5, epic task-4cfpv.9): route the launch through
# Gas City's session runtime instead of a herdr tab or the hand-rolled
# detached subprocess. Strictly opt-in (PARLAY_SPAWN_LAUNCHER=gc or [spawn]
# launcher = "gc"); the heavy lifting — pinned-gc resolution ($PARLAY_GC wins,
# refuse-loudly if absent), city scaffold reconciliation, launch-spec-to-
# template synthesis, and `gc session new parlay.<id> --json --no-attach`
# under a parlay-owned GC_HOME with the supervisor port redirected — lives in
# the Go verb `parlay gc-spawn` (tools/cli/internal/commands/gc_spawn.go).
# The city runs the SUBPROCESS session provider (city/city.toml [session]),
# so the launched session is a detached process: no tab, no tmux.
if [ "$KIND" != "claude" ]; then
  echo "parlay-spawn: the gc launcher only supports --kind claude for now (got '$KIND') — use herdr or --subprocess." >&2
  exit 1
fi
GC_PROMPT_FILE="$AGENT_DIR/startup-prompt.txt"
printf '%s\n' "$STARTUP_PROMPT" > "$GC_PROMPT_FILE"
# The resolved account token (OAUTH_ENV_FLAG) is deliberately NOT forwarded:
# the gc template's [env] is persisted to disk, and a secret must never
# travel that way. The account NAME rides along instead (the template's
# PARLAY_SPAWN_DEFAULT_ACCOUNT env), per gctemplate.LaunchSpec's contract.
if ! GC_SPAWN_JSON=$("$BIN_DIR/parlay" gc-spawn "$AGENT_ID" \
    --name "$NAME" --color "$COLOR" --cwd "$CWD" \
    --prompt-file "$GC_PROMPT_FILE" --server "$PARLAY" \
    ${MODEL:+--model "$MODEL"} ${ACCOUNT:+--account "$ACCOUNT"} \
    --json); then
  echo "parlay-spawn: gc-spawn failed to launch $AGENT_ID." >&2
  exit 1
fi
GC_SESSION_ID=$(printf '%s' "$GC_SPAWN_JSON" | jq -r '.session_id // empty' 2>/dev/null) || GC_SESSION_ID=""
GC_CITY_DIR=$(printf '%s' "$GC_SPAWN_JSON" | jq -r '.city_dir // empty' 2>/dev/null) || GC_CITY_DIR=""
echo "parlay-spawn: gc session '${GC_SESSION_ID:-unknown}' launched for $AGENT_ID (city: ${GC_CITY_DIR:-unknown})." >&2

elif [ "$LAUNCHER" != "subprocess" ]; then
# Give the agent its OWN tab (captain's rule 2026-07-13: agents never split the
# captain's current tab, and they launch unfocused/background). The tab's root
# pane becomes the agent's pane directly — `agent start` targets it below via
# --pane, so there is no redundant pane to close afterward.
#
# In-place mode (--pane <ID>): skip tab creation and use the caller's pane
# directly. The caller (yolo) backgrounds this script and returns so the pane
# is idle by the time we reach the send-text/agent-start steps below.
TAB_ID=""
ROOT_PANE=""
if [ -n "$IN_PLACE_PANE" ]; then
  ROOT_PANE="$IN_PLACE_PANE"
  echo "parlay-spawn: in-place mode — using caller's pane $ROOT_PANE" >&2
elif _herdr_use_rpc; then
  # Build the env object from fixed vars + optionals + PROJECT_ENV_FLAGS pairs.
  _tab_env=$(jq -nc \
    --arg ps "$PARLAY" \
    --arg ai "$AGENT_ID" \
    --arg an "$NAME" \
    --arg ac "$COLOR" \
    '{"PARLAY_SERVER":$ps,"PARLAY_AGENT_ID":$ai,"PARLAY_AGENT_NAME":$an,"PARLAY_AGENT_COLOR":$ac}')
  [ -n "$MODEL" ] && _tab_env=$(printf '%s' "$_tab_env" | jq --arg m "$MODEL" '.PARLAY_AGENT_MODEL=$m')
  [ -n "${_token:-}" ] && _tab_env=$(printf '%s' "$_tab_env" | jq --arg t "$_token" '.CLAUDE_CODE_OAUTH_TOKEN=$t')
  _tab_env_i=1
  while [ "$_tab_env_i" -lt "${#PROJECT_ENV_FLAGS[@]}" ]; do
    _tab_kv="${PROJECT_ENV_FLAGS[$_tab_env_i]}"
    _tab_env=$(printf '%s' "$_tab_env" | jq --arg k "${_tab_kv%%=*}" --arg v "${_tab_kv#*=}" '.[$k]=$v')
    _tab_env_i=$((_tab_env_i + 2))
  done
  _tab_nofocus=true; [ "${FOCUS_FLAG:-}" != "--no-focus" ] && _tab_nofocus=false
  _tab_params=$(jq -nc \
    --arg c "$CWD" \
    --arg l "$AGENT_ID" \
    --argjson f "$_tab_nofocus" \
    --argjson e "$_tab_env" \
    '{"cwd":$c,"label":$l,"no_focus":$f,"env":$e}')
  [ -n "${WORKSPACE:-}" ] && _tab_params=$(printf '%s' "$_tab_params" | jq --arg w "$WORKSPACE" '.workspace_id=$w')
  TAB_JSON=$(herdr_rpc "tab.create" "$_tab_params" 2>/dev/null) || true
  TAB_ID=$(printf '%s' "$TAB_JSON" | jq -r '.result.tab.tab_id // empty')
  ROOT_PANE=$(printf '%s' "$TAB_JSON" | jq -r '.result.root_pane.pane_id // empty')
else
  TAB_JSON=$(herdr tab create --cwd "$CWD" $FOCUS_FLAG --label "$AGENT_ID" \
    ${WORKSPACE:+--workspace "$WORKSPACE"} \
    --env "PARLAY_SERVER=$PARLAY" \
    --env "PARLAY_AGENT_ID=$AGENT_ID" \
    --env "PARLAY_AGENT_NAME=$NAME" \
    --env "PARLAY_AGENT_COLOR=$COLOR" \
    ${MODEL:+--env "PARLAY_AGENT_MODEL=$MODEL"} \
    ${OAUTH_ENV_FLAG[@]+"${OAUTH_ENV_FLAG[@]}"} \
    ${PROJECT_ENV_FLAGS[@]+"${PROJECT_ENV_FLAGS[@]}"} \
    2>/dev/null) || true
  TAB_ID=$(printf '%s' "$TAB_JSON" | jq -r '.result.tab.tab_id // empty')
  ROOT_PANE=$(printf '%s' "$TAB_JSON" | jq -r '.result.root_pane.pane_id // empty')
fi

if [ -z "$ROOT_PANE" ]; then
  echo "parlay-spawn: herdr tab create failed — no root pane returned." >&2
  [ -n "$TAB_ID" ] && _herdr_tab_close "$TAB_ID" || true
  exit 1
fi
( _spawn_snapshot "pane-launched" "$ROOT_PANE" ) &

# Pre-clear the nesting-marker vars in the pane's login shell before handing
# it to `agent start` — this is the `unset` half of the old bash wrapper.
# `agent start` immediately afterward needs the pane genuinely back at an idle
# prompt ("agent target pane is not an available shell" otherwise), so confirm
# execution rather than guessing a sleep is long enough. The trailing
# `echo READY_$$` marker sits as literal unresolved text ($$ shown verbatim)
# while merely typed-but-unsubmitted in the pane, and only expands to an
# actual PID once the shell truly executes it — wait-output matches the
# expanded (digits) form so it can't fire on the echoed keystrokes alone.
#
# In-place mode: the pane's env vars were NOT set via `herdr tab create --env`,
# so export them explicitly here before launching the agent.
_pane_prep="unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH AI_AGENT CLAUDE_EFFORT"
if [ -n "$IN_PLACE_PANE" ]; then
  _pane_prep="$_pane_prep; export PARLAY_SERVER=$(shell_quote "$PARLAY")"
  _pane_prep="$_pane_prep; export PARLAY_AGENT_ID=$(shell_quote "$AGENT_ID")"
  _pane_prep="$_pane_prep; export PARLAY_AGENT_NAME=$(shell_quote "$NAME")"
  _pane_prep="$_pane_prep; export PARLAY_AGENT_COLOR=$(shell_quote "$COLOR")"
  [ -n "$MODEL" ] && _pane_prep="$_pane_prep; export PARLAY_AGENT_MODEL=$(shell_quote "$MODEL")"
  [ -n "${_token:-}" ] && _pane_prep="$_pane_prep; export CLAUDE_CODE_OAUTH_TOKEN=$(shell_quote "$_token")"
  _ip_i=1
  while [ "$_ip_i" -lt "${#PROJECT_ENV_FLAGS[@]}" ]; do
    _pane_prep="$_pane_prep; export $(shell_quote "${PROJECT_ENV_FLAGS[$_ip_i]}")"
    _ip_i=$((_ip_i + 2))
  done
fi
_pane_prep="$_pane_prep; echo READY_\$\$"
_herdr_pane_send_text "$ROOT_PANE" "$_pane_prep"
_herdr_pane_send_keys "$ROOT_PANE" enter
_herdr_pane_wait_output "$ROOT_PANE" 'READY_[0-9]+' 5000
( _spawn_snapshot "pane-prep-done" "$ROOT_PANE" ) &

# Runs in YOLO mode (skip-permissions + sonnet fallback) — same as the `yolo`
# command — so a remotely-driven agent never stalls on a permission prompt the
# absent user can't answer. The charter is NOT passed here: `agent start` types
# its trailing args into the pane as a shell command line, and the charter is
# multi-line — an embedded newline would submit the command early and herdr
# refuses to encode it ("agent arguments cannot be encoded safely for the
# target shell"). So claude launches bare, then `agent prompt` below delivers
# the real charter through herdr's paste-safe submission channel instead.
# Retry 'agent start' on the agent_pane_busy race (robots-i4pi). Even after the
# READY marker confirms the pane's shell executed a command, herdr's own
# pane-availability bookkeeping lags by a beat, so the FIRST 'agent start'
# reliably rejects with agent_pane_busy ('… is not an available shell') on a
# brand-new per-ticket pane — NOT the shared-pane case robots-1uez fixed.
# Empirically the pane settles within 0–3 retries at 300ms, but the tail
# occasionally runs longer under load, so the budget is generous (12 attempts,
# tunable via PARLAY_SPAWN_START_RETRIES); it is only spent while the pane is
# genuinely busy. Only agent_pane_busy is retried — any other failure is
# non-transient and rolls back immediately.
# Agent-start args by harness kind. claude launches in YOLO mode
# (--dangerously-skip-permissions + sonnet fallback) so a remotely-driven agent
# never stalls on a permission prompt the absent user can't answer; other kinds
# (e.g. opencode) take only an explicit --model and rely on their own config for
# permissions/fallback (opencode's permission surface is its opencode.json).
case "$KIND" in
  claude) AGENT_START_ARGS=(--dangerously-skip-permissions --strict-mcp-config --fallback-model sonnet --settings '{"enabledPlugins":{"posthog@claude-plugins-official":false}}') ;;
  *)      AGENT_START_ARGS=() ;;
esac
[ -n "$MODEL" ] && AGENT_START_ARGS+=(--model "$MODEL")

_start_attempts="${PARLAY_SPAWN_START_RETRIES:-60}"
_start_ok=0
_start_out=""
_try=1
while [ "$_try" -le "$_start_attempts" ]; do
  if _start_out=$(_herdr_agent_start "$AGENT_ID" "$KIND" "$ROOT_PANE" \
      ${AGENT_START_ARGS[@]+"${AGENT_START_ARGS[@]}"}); then
    # Guard against a hypothetical exit-0-with-error-object; treat a busy marker
    # in the output as failure regardless of exit code.
    case "$_start_out" in
      *agent_pane_busy*) : ;;
      *) _start_ok=1; break ;;
    esac
  else
    case "$_start_out" in
      *agent_pane_busy*) : ;;                 # transient — retry after a beat
      *) break ;;                             # non-transient failure — stop
    esac
  fi
  [ "$_try" -lt "$_start_attempts" ] && { echo "parlay-spawn: agent_pane_busy on pane $ROOT_PANE — retry $_try/$_start_attempts …" >&2; /bin/sleep 0.5; }
  _try=$((_try + 1))
done
if [ "$_start_ok" -ne 1 ]; then
  echo "parlay-spawn: herdr agent start failed after $_try attempt(s) — rolling back the tab to avoid a ghost '$AGENT_ID' tab. (last: $_start_out)" >&2
  [ -n "$TAB_ID" ] && _herdr_tab_close "$TAB_ID" || true
  exit 1
fi
( _spawn_snapshot "agent-started" "$ROOT_PANE" ) &

if ! _herdr_agent_prompt "$AGENT_ID" "$STARTUP_PROMPT"; then
  echo "parlay-spawn: herdr agent prompt failed to deliver the charter — rolling back the tab to avoid a ghost '$AGENT_ID' tab." >&2
  [ -n "$TAB_ID" ] && _herdr_tab_close "$TAB_ID" || true
  exit 1
fi
( _spawn_snapshot "prompt-injected" "$ROOT_PANE" ) &
( _spawn_snapshot "post-prompt" "$ROOT_PANE" ) &

else
# subprocess launcher: a detached subprocess instead of a herdr terminal tab —
# the escape hatch for herdr's SIGKILL failure mode in headless/no-WindowServer
# environments. No tab/pane exists, so the charter can't be delivered via
# herdr's paste-safe `agent prompt` channel; instead it is written to disk and
# piped into the agent process's stdin as part of its one-shot launch command
# (tools/parlay-bin's subprocess-spawn runs `sh -c <command>` once, detached —
# see tools/parlay-bin/subprocess_spawn.go's header comment for the full design
# rationale, including why this is a from-scratch port of the old gascity
# lifecycle semantics rather than an import or a `gc` CLI wrapper).
SUBPROCESS_PROMPT_FILE="$AGENT_DIR/startup-prompt.txt"
printf '%s\n' "$STARTUP_PROMPT" > "$SUBPROCESS_PROMPT_FILE"

# Same YOLO-mode args as the herdr path's $AGENT_START_ARGS, expressed as a
# claude CLI flag string instead of a herdr `agent start` argv.
case "$KIND" in
  claude) SUBPROCESS_CMD_ARGS="--dangerously-skip-permissions --fallback-model sonnet" ;;
  *)      SUBPROCESS_CMD_ARGS="" ;;
esac
[ -n "$MODEL" ] && SUBPROCESS_CMD_ARGS="$SUBPROCESS_CMD_ARGS --model $(shell_quote "$MODEL")"

# Mirrors the herdr path's in-place `_pane_prep` unset list (line ~968) — new
# subprocess children inherit this CLI's own CLAUDECODE/CLAUDE_CODE_* env same
# as a fresh herdr pane does, so the same nesting-marker unset applies here.
SUBPROCESS_ENV_UNSET="unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH AI_AGENT CLAUDE_EFFORT"
SUBPROCESS_COMMAND="$SUBPROCESS_ENV_UNSET; cd $(shell_quote "$CWD") && exec $(shell_quote "$KIND") $SUBPROCESS_CMD_ARGS < $(shell_quote "$SUBPROCESS_PROMPT_FILE")"

# Env overrides for the child process — mirrors the herdr path's tab --env set
# (PARLAY_* profile vars, optional OAuth token, PROJECT_ENV_FLAGS pairs).
SUBPROCESS_ENV_ARGS=(--env "PARLAY_SERVER=$PARLAY" --env "PARLAY_AGENT_ID=$AGENT_ID" --env "PARLAY_AGENT_NAME=$NAME" --env "PARLAY_AGENT_COLOR=$COLOR")
[ -n "$MODEL" ] && SUBPROCESS_ENV_ARGS+=(--env "PARLAY_AGENT_MODEL=$MODEL")
[ -n "${_token:-}" ] && SUBPROCESS_ENV_ARGS+=(--env "CLAUDE_CODE_OAUTH_TOKEN=$_token")
_se_i=1
while [ "$_se_i" -lt "${#PROJECT_ENV_FLAGS[@]}" ]; do
  SUBPROCESS_ENV_ARGS+=(--env "${PROJECT_ENV_FLAGS[$_se_i]}")
  _se_i=$((_se_i + 2))
done

# Only pass --worktree-path when WORKTREE_PATH came from a verified treehouse
# lease (TREEHOUSE_LEASED_PATH), never a plain git-worktree fallback — see
# this file's TREEHOUSE_LEASED_PATH assignment in the worktree-setup step.
SUBPROCESS_WORKTREE_FLAG=()
[ -n "$TREEHOUSE_LEASED_PATH" ] && SUBPROCESS_WORKTREE_FLAG=(--worktree-path "$TREEHOUSE_LEASED_PATH")

# Build tools/parlay-bin if missing or stale, mirroring bin/parlay's own
# build-if-stale pattern for tools/cli.
SUBPROCESS_BIN_DIR="$BIN_DIR/../tools/parlay-bin"
SUBPROCESS_GO_BIN="$SUBPROCESS_BIN_DIR/bin/parlay-bin"
if [ ! -x "$SUBPROCESS_GO_BIN" ] || [ -n "$(find "$SUBPROCESS_BIN_DIR" -name '*.go' -newer "$SUBPROCESS_GO_BIN" -print -quit)" ]; then
  mkdir -p "$(dirname "$SUBPROCESS_GO_BIN")"
  (cd "$SUBPROCESS_BIN_DIR" && go build -o "$SUBPROCESS_GO_BIN" .) || exit 1
fi

if ! "$SUBPROCESS_GO_BIN" subprocess-spawn "$AGENT_ID" "$SUBPROCESS_COMMAND" "$CWD" \
    --state-dir "$AGENT_DIR/gascity" \
    "${SUBPROCESS_ENV_ARGS[@]}" \
    ${SUBPROCESS_WORKTREE_FLAG[@]+"${SUBPROCESS_WORKTREE_FLAG[@]}"} \
    ${BEAD_ID:+--bead-id "$BEAD_ID"}; then
  echo "parlay-spawn: subprocess-spawn failed to launch $AGENT_ID." >&2
  exit 1
fi
echo "parlay-spawn: subprocess session '$AGENT_ID' launched (state dir: $AGENT_DIR/gascity)." >&2
fi

# Seed the identity's LAUNCH SPEC (frontmatter) so the agent can reconstitute itself
# on context reset — the identity fully describes how to relaunch it. Best-effort.
# Ephemeral agents were already seeded by the mint step (with `ephemeral: true`);
# re-registering here without --ephemeral would strip that marker, so skip it.
# Fold §3.2: also record mode/effort/yolo/kind so a relaunch restores full lifecycle
# context, not just id/name/color. yolo/effort are claude-only: yolo=on because
# parlay-spawn launches claude with --dangerously-skip-permissions; other kinds
# (opencode) don't map them, so they are omitted.
#
# robots-jusi: this call used to be `>/dev/null 2>&1 || true`, which swallowed a
# fatal unknown-flag exit when the Go port dropped --worktree/--project. The spec
# was never written, so `parlay teardown` saw no `worktree:` field and took its
# no-worktree fast path — silently skipping every safety guard. Registration stays
# non-fatal (a launch spec is not worth aborting a live spawn over), but a failure
# is now LOUD: the CLI's own error reaches stderr and we name it explicitly.
if [ "$EPHEMERAL" -eq 0 ]; then
  REGISTER_META=(--mode "$MODE" --kind "$KIND")
  if [ "$KIND" = "claude" ]; then
    REGISTER_META+=(--yolo on)
    [ -n "$EFFORT" ] && REGISTER_META+=(--effort "$EFFORT")
  fi
  # Unit 7 (spawn-lift): under the gc launcher, dual-write the session
  # pointer (bead id + city dir) into the launch spec. identity.md stays the
  # projection; the city's bead store is the source of truth `parlay
  # gc-resolve` reads. Empty/unset on every other launcher — byte-identical
  # registration there.
  if ! identity --register --agent "$AGENT_ID" --name "$NAME" --color "$COLOR" --cwd "$CWD" \
    ${MODEL:+--model "$MODEL"} \
    ${REGISTER_META[@]+"${REGISTER_META[@]}"} \
    ${WORKTREE_PATH:+--worktree "$WORKTREE_PATH"} \
    ${PROJECT_PATH:+--project "$PROJECT_PATH"} \
    ${BEAD_ID:+--bead "$BEAD_ID"} \
    ${GC_SESSION_ID:+--gc-session "$GC_SESSION_ID"} \
    ${GC_CITY_DIR:+--gc-city "$GC_CITY_DIR"} \
    >/dev/null; then
    echo "parlay-spawn: WARNING — identity --register failed for $AGENT_ID; no launch spec written." >&2
    echo "  This agent cannot self-reconstitute after a context reset, and if it holds a worktree," >&2
    echo "  'parlay teardown' will not see it and will skip its uncommitted/unpushed guards." >&2
  fi
fi

# 6. Post-launch liveness watchdog (robots-3c0). The charter was just delivered
#    via `agent prompt` above, which should auto-run the first turn — but
#    intermittently that turn never fires (a boot race, or a rendered trust
#    dialog swallowing the submission) and the agent sits idle at an empty
#    composer, silently doing nothing until a supervisor happens to peek.
#    Confirm it goes 'working' within a generous window; if it never does,
#    resubmit the charter via the same paste-safe `agent prompt` channel
#    (herdr 0.7.5 removed the old no-Enter `agent send` + `verify-send` pair
#    this used to rely on — `agent prompt` submits and confirms in one call).
#    Backgrounded + disowned so batch spawns keep their fast return. The 60s
#    default is generous on purpose: a real first turn (enroll + arm monitor +
#    reply + begin the task) runs well past it, so a working agent is observed
#    long before the timeout and this never nudges it. Disable with
#    PARLAY_SPAWN_NO_WATCHDOG=1; tune with PARLAY_SPAWN_LIVENESS_TIMEOUT_MS.
LIVENESS_TIMEOUT_MS="${PARLAY_SPAWN_LIVENESS_TIMEOUT_MS:-60000}"
if [ "$LAUNCHER" = "gc" ]; then
  # gc path (unit 6): confirm-or-report is delegated to `parlay gc-liveness`.
  # It confirms the startup turn from the agent's own emitted effect — its
  # channel appearing in /api/chat/subscribers — and on timeout routes any
  # steering through the gc-nudge capability gate (R7): a typed refusal on
  # the subprocess provider, a short fixed kick on injection-capable ones,
  # NEVER a charter re-prompt. The charter went out exactly once via the gc
  # template; this watchdog is structurally unable to send it again. The
  # verb's --json envelope is appended to $AGENT_DIR/charter-delivery as the
  # durable answer to "was the startup turn confirmed?".
  if [ "${PARLAY_SPAWN_NO_WATCHDOG:-0}" != "1" ]; then
    GC_WATCHDOG_LOG="${TMPDIR:-/tmp}/parlay-spawn-gc-watchdog.log"
    (
      # gc-liveness exits 1 on the report path while still emitting its JSON
      # envelope — capture stdout regardless of exit (robots-dcag: a plain
      # VAR=$(cmd) under set -e is not best-effort).
      GC_LIVENESS_JSON="$("$BIN_DIR/parlay" gc-liveness "$AGENT_ID" \
        ${GC_SESSION_ID:+--session "$GC_SESSION_ID"} \
        --server "$PARLAY" --timeout-ms "$LIVENESS_TIMEOUT_MS" --json)" || true
      if [ -n "$GC_LIVENESS_JSON" ]; then
        printf '%s\n' "$GC_LIVENESS_JSON" >>"$AGENT_DIR/charter-delivery" || true
        echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: gc-liveness envelope recorded in $AGENT_DIR/charter-delivery" >&2
        printf '%s\n' "$GC_LIVENESS_JSON" >&2
      else
        echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: gc-liveness emitted no envelope — inspect the gc session: <pinned gc> --city ${GC_CITY_DIR:-\$PARLAY_STATE_HOME/gascity/city} session list --json" >&2
      fi
    ) </dev/null >>"$GC_WATCHDOG_LOG" 2>&1 &
    disown 2>/dev/null || true
    echo "parlay-spawn: gc liveness watchdog armed (confirm-or-report via 'parlay gc-liveness', ${LIVENESS_TIMEOUT_MS}ms); log: $GC_WATCHDOG_LOG" >&2
  fi
elif [ "$LAUNCHER" = "subprocess" ]; then
  # subprocess launcher path: there is no herdr agent to `agent wait` on, so
  # liveness is observed the same way any client confirms an agent is
  # connected — polling this server's own /api/chat/subscribers for the
  # agent's channel. Same opt-out/tuning knobs as the herdr watchdog for
  # operational parity. Observation only, never a re-prompt.
  if [ "${PARLAY_SPAWN_NO_WATCHDOG:-0}" != "1" ]; then
    SUBPROCESS_LIVENESS_TIMEOUT_S=$(( LIVENESS_TIMEOUT_MS / 1000 ))
    [ "$SUBPROCESS_LIVENESS_TIMEOUT_S" -lt 1 ] && SUBPROCESS_LIVENESS_TIMEOUT_S=60
    SUBPROCESS_WATCHDOG_LOG="${TMPDIR:-/tmp}/parlay-spawn-subprocess-watchdog.log"
    SUBPROCESS_TIMEOUT_HINT="inspect $AGENT_DIR/gascity or run '$SUBPROCESS_GO_BIN subprocess-ping $AGENT_ID --state-dir $AGENT_DIR/gascity'"
    (
      _subprocess_elapsed=0
      while [ "$_subprocess_elapsed" -lt "$SUBPROCESS_LIVENESS_TIMEOUT_S" ]; do
        # /subscribers is an OBJECT, not an array ('.[]' over it dies on the
        # first array-valued field, so the old array parse could never match).
        # Registration rows don't count — this script's own register-agent
        # POST creates those before the agent runs; only the agent's poll
        # listener (an open waiter, or a listening presence row) is its own
        # emitted effect. Kept in lockstep with gcLivenessObserved
        # (tools/cli/internal/commands/gc_liveness.go).
        if curl -fsS "$PARLAY/api/chat/subscribers" 2>/dev/null \
            | jq -e --arg id "$AGENT_ID" \
              '((.poll.channels // []) | any(.channel == $id)) or ((.presence // []) | any(.channel == $id and .listening == true))' \
              >/dev/null 2>&1; then
          echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: observed in /api/chat/subscribers — session live." >&2
          exit 0
        fi
        /bin/sleep 1
        _subprocess_elapsed=$((_subprocess_elapsed + 1))
      done
      echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: did not appear in /api/chat/subscribers within ${SUBPROCESS_LIVENESS_TIMEOUT_S}s — $SUBPROCESS_TIMEOUT_HINT." >&2
    ) </dev/null >>"$SUBPROCESS_WATCHDOG_LOG" 2>&1 &
    disown 2>/dev/null || true
    echo "parlay-spawn: $LAUNCHER liveness watchdog armed (${SUBPROCESS_LIVENESS_TIMEOUT_S}s → poll /api/chat/subscribers); log: $SUBPROCESS_WATCHDOG_LOG" >&2
  fi
elif [ "${PARLAY_SPAWN_NO_WATCHDOG:-0}" != "1" ] && (_herdr_use_rpc || command -v herdr >/dev/null 2>&1); then
  WATCHDOG_LOG="${TMPDIR:-/tmp}/parlay-spawn-watchdog.log"
  (
    # `agent wait` returns 0 as soon as the agent is observed 'working' — the
    # normal auto-start path exits here having done nothing.
    if _herdr_agent_wait "$AGENT_ID" working "$LIVENESS_TIMEOUT_MS"; then
      exit 0
    fi
    echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: initial turn never fired within ${LIVENESS_TIMEOUT_MS}ms — resubmitting charter." >&2
    # A never-started agent has done no work, so resubmitting the charter kicks
    # it off without duplicating anything.
    if _herdr_agent_prompt_wait "$AGENT_ID" "$STARTUP_PROMPT" working 30000; then
      echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: nudge confirmed — agent working." >&2
    else
      echo "$(date -u +%FT%TZ) parlay-spawn[$AGENT_ID]: nudge did not confirm landing — inspect the tab." >&2
    fi
  ) </dev/null >>"$WATCHDOG_LOG" 2>&1 &
  disown 2>/dev/null || true
  echo "parlay-spawn: liveness watchdog armed (${LIVENESS_TIMEOUT_MS}ms → nudge if idle); log: $WATCHDOG_LOG" >&2
fi

echo "parlay-spawn: done. Agent '$AGENT_ID' registered; terminal launched." >&2
echo "parlay-spawn: watch it come live with: parlay subscribers | jq '.poll'" >&2
