#!/usr/bin/env bash
# Wrapper: routes parlay to the Pulse server running on port 31337.
# Override with PARLAY_SERVER env var if needed.
export PARLAY_SERVER="${PARLAY_SERVER:-http://localhost:31337}"
# Resolve this script through any symlinks (e.g. ~/.local/bin/parlay -> repo bin/parlay),
# then derive the CLI path from the repo location — never hardcode /Users/<name>, which
# breaks for any other user/host (robots-su0j: mini3 runs as a different user).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# Go rewrite of packages/cli (ticket B10, workstream B). Build the binary if
# missing or stale (any tools/cli source newer than it), then exec it in
# place of the old `bun packages/cli/src/index.ts`.
CLI_DIR="$REPO/tools/cli"
GO_BIN="$CLI_DIR/bin/parlay-cli"
if [ ! -x "$GO_BIN" ] || [ -n "$(find "$CLI_DIR" -name '*.go' -newer "$GO_BIN" -print -quit)" ]; then
  mkdir -p "$(dirname "$GO_BIN")"
  (cd "$CLI_DIR" && go build -o "$GO_BIN" .) || exit 1
fi
exec "$GO_BIN" "$@"
